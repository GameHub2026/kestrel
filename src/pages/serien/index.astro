---
import Base from '../../layouts/Base.astro';
---
<Base title="Ich folge" privat description="Private Liste der Serien, Filme und Spiele, denen ich folge.">
<div class="ser kacheln" id="ser">
  <header class="page-head wrap">
    <h1>Ich folge</h1>
    <p>Alles aus Plex (über Trakt) und alles mit Glocke. Täglich geprüft: neue Staffeln und Teile, Termine, Ableger, Trailer, News.</p>
    <div class="ansicht kopf-rechts" id="ansicht" role="group" aria-label="Ansicht" hidden>
      <button type="button" data-ansicht="liste" aria-pressed="false" aria-label="Liste" title="Liste"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
      <button type="button" data-ansicht="kacheln" aria-pressed="true" aria-label="Kacheln" title="Kacheln"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg></button>
    </div>
  </header>

  <section class="wrap zugang" id="zugang" hidden>
    <p>Für diese Seite brauchst du deinen Zugangsschlüssel.</p>
    <form id="zugang-form">
      <label class="visually-hidden" for="zugang-feld">Zugangsschlüssel</label>
      <input id="zugang-feld" type="password" autocomplete="current-password" placeholder="Zugangsschlüssel" required />
      <button type="submit">Öffnen</button>
    </form>
  </section>

  <div id="app" hidden>
    <section class="wrap" aria-labelledby="neu-h">
      <div class="kopfzeile">
        <h2 id="neu-h" class="abschnitt">Neu für dich</h2>
        <button type="button" class="knopf leise" id="gesehen" hidden>Alles gesehen</button>
      </div>
      <ul class="hinweise" id="hinweise"></ul>
      <p class="leer" id="hinweise-leer" hidden>Gerade nichts Neues.</p>
    </section>

    <section class="wrap" aria-labelledby="kommt-h">
      <h2 id="kommt-h" class="abschnitt">Kommt als Nächstes</h2>
      <ul class="kommt" id="kommt"></ul>
      <p class="leer" id="kommt-leer" hidden>Gerade nichts angekündigt.</p>
    </section>

    <section class="wrap" aria-labelledby="folgen-h">
      <h2 id="folgen-h" class="abschnitt">Folgen</h2>
      <div class="suche">
        <label class="visually-hidden" for="such-feld">Serie, Film oder Spiel suchen</label>
        <input id="such-feld" type="search" autocomplete="off" placeholder="Serie, Film oder Spiel suchen …" />
      </div>
      <p class="hinweis mono" id="such-status" aria-live="polite"></p>
      <ul class="treffer" id="treffer"></ul>
    </section>

    <section class="wrap" aria-labelledby="alle-h">
      <div class="kopfzeile">
        <h2 id="alle-h" class="abschnitt">Ich folge <span id="anzahl"></span></h2>
        <p class="stand mono"><span id="stand"></span></p>
      </div>
      <nav class="filter" aria-label="Medium">
        <button type="button" data-m="" aria-pressed="true">Alle</button>
        <button type="button" data-m="serie" data-medium="serie" aria-pressed="false">Serien</button>
        <button type="button" data-m="film" data-medium="film" aria-pressed="false">Filme</button>
        <button type="button" data-m="spiel" data-medium="spiel" aria-pressed="false">Spiele</button>
      </nav>
      <ul class="raster" id="raster"></ul>
      <dialog class="sbox" id="sbox" aria-label="Details">
        <button type="button" class="sbox-zu" id="sbox-zu" aria-label="Schließen">×</button>
        <div id="sbox-inhalt"></div>
      </dialog>
      <details class="aus" id="aus-box" hidden>
        <summary class="mono">Nicht mehr verfolgt, auch Beendete und Abgesetzte (<span id="aus-zahl"></span>)</summary>
        <ul class="aus-liste" id="aus-liste"></ul>
      </details>
    </section>
  </div>
</div>
</Base>

<script>
  const SPEICHER = 'kestrel-merk-token';
  const $ = (s: string) => document.querySelector(s) as HTMLElement;
  type Punkt = { art: 'staffel' | 'status' | 'trailer' | 'news' | 'ableger'; titel: string; link?: string; quelle?: string; auch?: string[]; datum: string; termin?: string; neu: boolean };
  type Serie = { id: string; medium?: string; reihe?: string; titel: string; bild?: string; status?: string; quelle: 'trakt' | 'hand'; aus?: boolean; ausGrund?: string | null; anbieter?: string[]; naechste?: { staffel?: number; text?: string; datum: string | null } | null; naechsteFolge?: { datum: string; text: string } | null; punkte: Punkt[]; geprueft?: number };
  type Daten = { stand: number; gesehen: number; serien: Serie[] };

  let token = '';
  try { token = localStorage.getItem(SPEICHER) || ''; } catch {}
  let daten: Daten = { stand: 0, gesehen: 0, serien: [] };

  async function api(pfad: string, opt: RequestInit = {}) {
    const r = await fetch(pfad, { ...opt, headers: { 'x-merk-token': token, 'content-type': 'application/json' } });
    if (r.status === 401) { zeigeZugang(); throw new Error('Kein Zugang'); }
    const d = await r.json();
    if (!r.ok) throw new Error(d.fehler || 'Fehler');
    return d;
  }
  function zeigeZugang() { $('#app').hidden = true; $('#ansicht').hidden = true; $('#zugang').hidden = false; }
  $('#zugang-form').addEventListener('submit', (e) => {
    e.preventDefault();
    token = ($('#zugang-feld') as HTMLInputElement).value.trim();
    try { localStorage.setItem(SPEICHER, token); } catch {}
    start();
  });

  const el = (t: string, c?: string, x?: string) => { const n = document.createElement(t); if (c) n.className = c; if (x != null) n.textContent = x; return n; };
  const datumDe = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
  const relativ = (iso: string) => { const t = Math.floor((Date.now() - Date.parse(iso)) / 864e5); return t <= 0 ? 'heute' : t === 1 ? 'gestern' : `vor ${t} Tagen`; };
  const bis = (d: string) => { const t = Math.round((Date.parse(d + 'T12:00:00') - Date.now()) / 864e5); return t <= 0 ? 'heute' : t === 1 ? 'morgen' : `in ${t} Tagen`; };
  const ART: Record<string, string> = { ableger: 'Ableger', staffel: 'Neu',  status: 'Status', trailer: '▶ Trailer', news: 'News' };
  const gross = (u?: string) => u?.replace('/w154/', '/w342/');
  function poster(src?: string, klasse = 'poster') {
    const b = el('span', klasse);
    src = gross(src);
    if (src) { const i = document.createElement('img'); i.src = src; i.alt = ''; i.loading = 'lazy'; b.append(i); }
    return b;
  }

  const MED: Record<string, string> = { serie: 'Serie', film: 'Film', spiel: 'Spiel' };
  const artName = (p: Punkt, s: Serie) => p.art === 'staffel' ? (s.medium === 'film' ? 'Film' : s.medium === 'spiel' ? 'Spiel' : 'Staffel') : p.art === 'ableger' ? 'Universum' : ART[p.art];
  // Quelle, "auch bei …" und bei Terminen die verbleibenden Tage
  const quelleZeile = (p: Punkt) => [p.quelle, p.auch?.length ? `auch bei ${p.auch.join(', ')}` : '', p.termin ? `noch ${tage(p.termin)}` : '', relativ(p.datum)].filter(Boolean).join(' · ');
  const tage = (d: string) => { const t = Math.round((Date.parse(d + 'T12:00:00') - Date.now()) / 864e5); return t <= 0 ? 'heute' : t === 1 ? '1 Tag' : `${t} Tage`; };
  let filterM = '';

  function zeige() {
    const aktiv = daten.serien.filter((s) => !s.aus);
    // Neu für dich: auch Ableger beendeter Serien; gleiche Meldung (gleicher Link) nur einmal; Termine zuerst
    const gesehen = new Set<string>();
    const neu = daten.serien.filter((s) => !s.aus || s.ausGrund).flatMap((s) => s.punkte.filter((p) => p.neu).map((p) => ({ p, s })))
      .filter(({ p }) => { const k = p.link || p.titel; if (gesehen.has(k)) return false; gesehen.add(k); return true; })
      .sort((a, b) => (['staffel', 'ableger'].includes(a.p.art) ? 0 : 1) - (['staffel', 'ableger'].includes(b.p.art) ? 0 : 1) || b.p.datum.localeCompare(a.p.datum));
    $('#hinweise').replaceChildren(...neu.map(({ p, s }) => {
      const li = el('li', `hinweis-zeile art-${p.art}`);
      const mitte = el('div', 'mitte');
      mitte.append(el('span', 'art mono', `${artName(p, s)} · ${s.titel}`));
      if (p.link) { const a = el('a', 'h-titel', p.titel) as HTMLAnchorElement; a.href = p.link; a.target = '_blank'; a.rel = 'noopener'; mitte.append(a); }
      else mitte.append(el('span', 'h-titel', p.titel));
      mitte.append(el('span', 'quelle mono', quelleZeile(p)));
      li.append(poster(s.bild), mitte);
      klickbar(li, s);
      return li;
    }));
    $('#hinweise-leer').hidden = neu.length > 0;
    $('#gesehen').hidden = neu.length === 0;

    // Kommende Staffeln: mit Termin nach Datum, danach angekündigte ohne Termin
    const kommt = aktiv.filter((s) => s.naechste).sort((a, b) => (a.naechste!.datum || '9999').localeCompare(b.naechste!.datum || '9999') || a.titel.localeCompare(b.titel, 'de'));
    $('#kommt').replaceChildren(...kommt.map((s) => {
      const li = el('li', 'kommt-zeile');
      const n = s.naechste!;
      klickbar(li, s);
      li.append(poster(s.bild));
      const was = s.medium === 'film' || s.medium === 'spiel' ? (['Kinostart', 'Release'].includes(n.text || '') ? n.text! : `Neuer Teil: ${n.text}`) : (n.text || `Staffel ${n.staffel}`);
      li.append(el('span', 'k-datum mono', n.datum ? `${datumDe(n.datum)} · noch ${tage(n.datum)}` : 'Termin offen'), el('span', 'k-titel', s.titel), el('span', 'k-staffel mono', `${was}${s.anbieter?.length ? ` · ${s.anbieter.join(', ')}` : ''}`));
      return li;
    }));
    $('#kommt-leer').hidden = kommt.length > 0;

    // Raster aller verfolgten Serien: zuerst die mit Neuem, dann laufende, beendete zuletzt
    const rang = (s: Serie) => (s.punkte.some((p) => p.neu) ? 0 : s.naechste ? 1 : /Beendet|Abgesetzt/.test(s.status || '') ? 3 : 2);
    $('#anzahl').textContent = `(${aktiv.length})`;
    $('#raster').replaceChildren(...aktiv.filter((s) => !filterM || (s.medium || 'serie') === filterM).sort((a, b) => rang(a) - rang(b) || a.titel.localeCompare(b.titel, 'de')).map((s) => {
      const li = el('li', 'kachel');
      const n = s.punkte.filter((p) => p.neu).length;
      const c = poster(s.bild, 'cover');
      if (n) c.append(el('span', 'neu-plakette mono', `${n} neu`));
      const info = el('div', 'k-info');
      info.append(el('span', 'k-name', s.titel));
      const was = s.naechste ? (s.medium === 'film' || s.medium === 'spiel' ? s.naechste.text! : (s.naechste.text || `Staffel ${s.naechste.staffel}`)) : '';
      const zeile = s.naechste ? (s.naechste.datum ? `${was}: ${datumDe(s.naechste.datum)} · noch ${tage(s.naechste.datum)}` : `${was} angekündigt`)
        : s.naechsteFolge ? `Nächste Folge ${s.naechsteFolge.text}: ${datumDe(s.naechsteFolge.datum)}` : (s.status || '');
      info.append(el('span', 'k-zeile mono', zeile), el('span', 'k-quelle mono', `${MED[s.medium || 'serie']} · ${s.quelle === 'trakt' ? 'aus Trakt' : 'von Hand'}`));
      const weg = el('button', 'k-weg', 'Nicht mehr folgen') as HTMLButtonElement; weg.type = 'button';
      weg.addEventListener('click', () => setzeAus(s, true));
      info.append(weg);
      li.append(c, info);
      klickbar(li, s);
      return li;
    }));

    const aus = daten.serien.filter((s) => s.aus);
    $('#aus-box').hidden = aus.length === 0; $('#aus-zahl').textContent = String(aus.length);
    $('#aus-liste').replaceChildren(...aus.sort((a, b) => a.titel.localeCompare(b.titel, 'de')).map((s) => {
      const li = el('li'); li.append(el('span', '', `${s.titel}${s.ausGrund ? ` · ${s.ausGrund}` : ''}`)); klickbar(li, s);
      const b = el('button', 'knopf leise klein', 'Wieder folgen') as HTMLButtonElement; b.type = 'button';
      b.addEventListener('click', () => setzeAus(s, false));
      li.append(b); return li;
    }));

    if (!prueftGerade) $('#stand').textContent = daten.stand ? `Automatisch geprüft: ${new Date(daten.stand).toLocaleString('de-DE', { dateStyle: 'short', timeStyle: 'short' })}` : 'Wird gleich geprüft …';
    try { sessionStorage.removeItem('kestrel-neu'); } catch {}
  }

  // Info-Box: Klick auf ein Poster zeigt Handlung, Fakten, Trailer und alles, was zur Serie/zum Film gefunden wurde
  type Det = { untertitel?: string; handlung?: string; genres: string[]; fakten: [string, string][]; anbieter: { abo: string[]; leihen: string[] }; trailer?: string; link?: string; linkName?: string };
  const sbox = $('#sbox') as HTMLDialogElement;
  function klickbar(li: HTMLElement, s: Serie) {
    li.classList.add('klickbar'); li.tabIndex = 0; li.setAttribute('role', 'button'); li.setAttribute('aria-haspopup', 'dialog');
    li.addEventListener('click', (ev) => { if ((ev.target as HTMLElement).closest('a, button')) return; oeffne(s); });
    li.addEventListener('keydown', (ev) => { if ((ev.key === 'Enter' || ev.key === ' ') && ev.target === li) { ev.preventDefault(); oeffne(s); } });
  }
  async function oeffne(s: Serie) {
    const kopf = el('div', 'sbox-kopf');
    const kern = el('div', 'mitte');
    kern.append(el('span', 'art mono', `${MED[s.medium || 'serie']}${s.reihe ? ` · ${s.reihe}` : ''} · ${s.status || ''}`), el('h2', 'sbox-titel', s.titel));
    if (s.naechste) {
      const was = s.medium === 'film' || s.medium === 'spiel' ? (['Kinostart', 'Release'].includes(s.naechste.text || '') ? s.naechste.text! : `Neuer Teil: ${s.naechste.text}`) : (s.naechste.text || `Staffel ${s.naechste.staffel}`);
      kern.append(el('span', 'sbox-termin mono', s.naechste.datum ? `${was}: ${datumDe(s.naechste.datum)} · noch ${tage(s.naechste.datum)}` : `${was} angekündigt, Termin offen`));
    } else if (s.naechsteFolge) kern.append(el('span', 'sbox-termin mono', `Nächste Folge ${s.naechsteFolge.text}: ${datumDe(s.naechsteFolge.datum)}`));
    kopf.append(poster(s.bild, 'sbox-bild'), kern);
    const details = el('div', 'sbox-details'); details.append(el('p', 'mono laed', 'Lade Details …'));
    const gefunden = el('div', 'sbox-gefunden');
    if (s.punkte.length) {
      gefunden.append(el('h3', 'mono', 'Gefunden'));
      const ul = el('ul');
      for (const x of s.punkte) {
        const li = el('li', x.neu ? 'ist-neu' : '');
        li.append(el('span', 'art mono', `${artName(x, s)}${x.neu ? ' · neu' : ''}`));
        if (x.link) { const a = el('a', '', x.titel) as HTMLAnchorElement; a.href = x.link; a.target = '_blank'; a.rel = 'noopener'; li.append(a); } else li.append(el('span', 'h-titel', x.titel));
        li.append(el('span', 'quelle mono', quelleZeile(x)));
        ul.append(li);
      }
      gefunden.append(ul);
    }
    const weg = el('button', 'knopf leise klein', s.aus ? 'Wieder folgen' : 'Nicht mehr folgen') as HTMLButtonElement; weg.type = 'button';
    weg.addEventListener('click', async () => { sbox.close(); await setzeAus(s, !s.aus); });
    $('#sbox-inhalt').replaceChildren(kopf, details, gefunden, weg);
    sbox.showModal();
    try {
      const d: Det = await api(`/api/merk/details?id=${encodeURIComponent(s.id)}`);
      const teile: HTMLElement[] = [];
      if (d.untertitel) teile.push(el('p', 'unter', d.untertitel));
      if (d.genres?.length) { const g = el('p', 'genres'); d.genres.forEach((x) => g.append(el('span', 'genre mono', x))); teile.push(g); }
      teile.push(el('p', 'handlung', d.handlung || 'Noch keine Beschreibung vorhanden.'));
      const dl = document.createElement('dl'); dl.className = 'fakten';
      const fakt = (k: string, v: string) => { const z = el('div'); z.append(el('dt', 'mono', k), el('dd', '', v)); dl.append(z); };
      (d.fakten || []).forEach(([k, v]) => fakt(k, v));
      if (d.anbieter?.abo?.length) fakt('Im Abo (DE)', d.anbieter.abo.join(', '));
      if (dl.children.length) teile.push(dl);
      const kn = el('p', 'knoepfe');
      if (d.trailer) { const a = el('a', 'knopf', '▶ Trailer ansehen') as HTMLAnchorElement; a.href = d.trailer; a.target = '_blank'; a.rel = 'noopener'; kn.append(a); }
      if (d.link) { const a = el('a', 'knopf leise', `Mehr bei ${d.linkName}`) as HTMLAnchorElement; a.href = d.link; a.target = '_blank'; a.rel = 'noopener'; kn.append(a); }
      if (kn.children.length) teile.push(kn);
      details.replaceChildren(...teile);
    } catch (err) { details.replaceChildren(el('p', 'mono', `Details gerade nicht verfügbar: ${(err as Error).message}`)); }
  }
  $('#sbox-zu').addEventListener('click', () => sbox.close());
  sbox.addEventListener('click', (ev) => { if (ev.target === sbox) sbox.close(); });

  // Ansicht: Kacheln (Standard) oder Liste, gilt für alle Bereiche
  const ser = $('#ser');
  function setzeAnsicht(a: string) {
    ser.classList.toggle('kacheln', a === 'kacheln');
    document.querySelectorAll<HTMLElement>('[data-ansicht]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ansicht === a)));
    try { localStorage.setItem('kestrel-serien-ansicht', a); } catch {}
  }
  document.querySelectorAll<HTMLElement>('[data-ansicht]').forEach((b) => b.addEventListener('click', () => setzeAnsicht(b.dataset.ansicht!)));
  try { setzeAnsicht(localStorage.getItem('kestrel-serien-ansicht') === 'liste' ? 'liste' : 'kacheln'); } catch {}

  async function setzeAus(s: Serie, aus: boolean) {
    daten = await api('/api/serien', { method: 'PATCH', body: JSON.stringify({ id: s.id, aus }) });
    zeige();
  }
  $('#gesehen').addEventListener('click', async () => { await api('/api/serien', { method: 'POST', body: JSON.stringify({ gesehen: true }) }); laden(); });

  // Automatisch prüfen: beim Öffnen, wenn der letzte Stand älter als 6 Stunden ist (sonst macht es der Morgenlauf)
  let prueftGerade = false;
  async function pruefeAutomatisch() {
    if (prueftGerade || (daten.stand && Date.now() - daten.stand < 6 * 3600e3)) return;
    prueftGerade = true;
    let ab: number | null = 0;
    try {
      while (ab !== null) {
        const r = await api(`/api/serien/pruefen?ab=${ab}`, { method: 'POST' });
        $('#stand').textContent = `Prüfe automatisch … ${Math.min((ab || 0) + r.geprueft, r.gesamt)} von ${r.gesamt}`;
        ab = r.weiter;
      }
      await laden();
    } catch { /* der Morgenlauf holt es nach */ }
    prueftGerade = false;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-m]').forEach((b) => b.addEventListener('click', () => {
    filterM = b.dataset.m || '';
    document.querySelectorAll('[data-m]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    zeige();
  }));

  // Suche (Serien, Filme, Spiele) und Folgen mit der Glocke
  let suchTimer = 0, suchNr = 0;
  async function suche() {
    const q = ($('#such-feld') as HTMLInputElement).value.trim();
    const ul = $('#treffer'); const status = $('#such-status');
    if (q.length < 2) { ul.replaceChildren(); status.textContent = ''; return; }
    const nr = ++suchNr; status.textContent = 'Suche …';
    try {
      const teile = await Promise.all(['serie', 'film', 'spiel'].map((m) => api(`/api/merk/suche?medium=${m}&q=${encodeURIComponent(q)}`).catch(() => [])));
      const treffer: any[] = []; for (let i = 0; i < 8; i++) for (const t of teile) if (t[i]) treffer.push(t[i]);
      if (nr !== suchNr) return;
      status.textContent = treffer.length ? '' : 'Nichts gefunden.';
      ul.replaceChildren(...treffer.map((t: { id: string; medium: string; titel: string; jahr?: number; info?: string; bild?: string }) => {
        const li = el('li', 'treffer-zeile');
        const mitte = el('div', 'mitte'); mitte.append(el('span', 'titel', t.titel), el('span', 'mono info', [MED[t.medium], t.jahr, t.info].filter(Boolean).join(' · ')));
        const schon = daten.serien.some((s) => s.id === t.id && !s.aus);
        const b = el('button', 'glocke', schon ? '🔔 Folge ich' : '🔔 Folgen') as HTMLButtonElement; b.type = 'button'; b.disabled = schon;
        b.addEventListener('click', async () => {
          b.disabled = true; b.textContent = 'Prüfe …';
          try { daten = await api('/api/serien', { method: 'POST', body: JSON.stringify({ id: t.id, titel: t.titel }) }); b.textContent = '🔔 Folge ich'; zeige(); }
          catch (err) { b.disabled = false; b.textContent = '🔔 Folgen'; status.textContent = `Fehler: ${(err as Error).message}`; }
        });
        li.append(poster(t.bild), mitte, b); return li;
      }));
    } catch (err) { if (nr === suchNr) status.textContent = `Suche fehlgeschlagen: ${(err as Error).message}`; }
  }
  $('#such-feld').addEventListener('input', () => { clearTimeout(suchTimer); suchTimer = window.setTimeout(suche, 350); });

  async function laden() { daten = await api('/api/serien'); zeige(); }
  async function start() {
    if (!token) return zeigeZugang();
    try { await laden(); } catch { return; }
    $('#zugang').hidden = true; $('#app').hidden = false; $('#ansicht').hidden = false;
    pruefeAutomatisch();
  }
  start();
</script>

<style is:global>
@keyframes sbox-auf { from { opacity: 0; transform: translateY(14px) scale(0.98); } }
.ser {
  .kopfzeile { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .leer, .hinweis, .stand { color: var(--ink-2); }
