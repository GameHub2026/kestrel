---
import Base from '../layouts/Base.astro';
import ArchivZeile from '../components/ArchivZeile.astro';
import ArchivTabs from '../components/ArchivTabs.astro';
import { alleTexte, jahr, monat, type Text } from '../lib';

const texte = await alleTexte();
const jahre = new Map<number, Map<string, Text[]>>();
for (const t of texte) {
  const j = jahr(t.data.datum);
  const m = monat(t.data.datum);
  if (!jahre.has(j)) jahre.set(j, new Map());
  const ms = jahre.get(j)!;
  if (!ms.has(m)) ms.set(m, []);
  ms.get(m)!.push(t);
}
const zaehle = (liste: Text[], medium: string) => liste.filter((t) => t.data.medium === medium).length;
const plural = { spiel: ['Spiel', 'Spiele'], film: ['Film', 'Filme'], serie: ['Serie', 'Serien'] } as const;
---
<Base title="Archiv" description="Alle Texte nach Jahr und Monat, als Rückblick: was Kevin wann gespielt und geschaut hat.">
  <header class="page-head wrap">
    <div class="kopf-schild">
      <h1>Archiv</h1>
      <p>Nach Jahr und Monat, in der Reihenfolge, in der ich geschrieben habe.</p>
      <p class="kopf-fakt mono">{texte.length} {texte.length === 1 ? 'Text' : 'Texte'}{texte.length ? ` · seit ${Math.min(...texte.map((t) => jahr(t.data.datum)))}` : ''}</p>
    </div>
  </header>
  <ArchivTabs />

  {[...jahre].map(([j, monate]) => {
    const alle = [...monate.values()].flat();
    const teile = (['spiel', 'film', 'serie'] as const)
      .map((m) => [m, zaehle(alle, m)] as const)
      .filter(([, n]) => n > 0)
      .map(([m, n]) => `${n} ${plural[m][n === 1 ? 0 : 1]}`);
    return (
      <section class="year wrap" aria-labelledby={`j${j}`}>
        <header class="year-head">
          <h2 id={`j${j}`} class="year-num">{j}</h2>
          <p class="year-sum mono">{alle.length} {alle.length === 1 ? 'Text' : 'Texte'} · {teile.join(' · ')}</p>
        </header>
        {[...monate].map(([m, liste]) => (
          <div class="month">
            <h3 class="month-name">{m}</h3>
            <ol class="stubs">
              {liste.map((t) => <ArchivZeile text={t} />)}
            </ol>
          </div>
        ))}
      </section>
    );
  })}
  {texte.length === 0 && <p class="wrap">Noch keine Texte im Archiv.</p>}
</Base>

<style>
  .year { margin-bottom: clamp(48px, 7vw, 80px); }
  .year-head { display: flex; align-items: baseline; gap: 8px 20px; flex-wrap: wrap; padding-bottom: 14px; margin-bottom: 8px; border-bottom: 1px solid var(--line); }
  .year-num { font-size: clamp(40px, 6vw, 56px); line-height: 1.07; font-weight: 600; letter-spacing: -0.005em; margin: 0; font-variant-numeric: tabular-nums; }
  .year-sum { margin: 0; color: var(--ink-2); font-size: 17px; }
  .month { display: grid; grid-template-columns: 10rem 1fr; gap: 16px; padding: 18px 0; }
  .month + .month { border-top: 1px solid var(--line); }
  .month-name { margin: 14px 0 0; font-size: 21px; font-weight: 600; line-height: 1.19; }
  .stubs { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  @media (max-width: 720px) { .month { grid-template-columns: 1fr; gap: 10px; } .month-name { margin-top: 0; } }
</style>
