---
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import { alleTexte } from '../lib';

const texte = await alleTexte();
const [neuester, ...rest] = texte;
const weitere = rest.slice(0, 6);
---
<Base>
  <section class="intro page-head wrap" data-kicker="Kritiken von Kevin · Spiele, Filme, Serien">
    <h1>Was ich spiele und schaue, ehrlich bewertet.</h1>
    <p>Wertung von 1 bis 10, <a href="/wie-ich-werte/">gleich für alle drei Medien</a>. Sehe ich etwas später anders, kommt ein Nachtrag dazu.</p>
  </section>

  {neuester ? (
    <>
      <section class="lead wrap" aria-label="Neuester Text">
        <div class="lead-card">
          <Ticket text={neuester} size="hero" />
        </div>
      </section>
      {weitere.length > 0 && (
        <section class="stack wrap" aria-labelledby="stack-h">
          <h2 id="stack-h" class="stack-h">Davor geschrieben</h2>
          <ol class="stack-list">
            {weitere.map((t) => <li><Ticket text={t} headingLevel="h3" /></li>)}
          </ol>
        </section>
      )}
      <p class="more wrap"><a href="/texte/">{texte.length > 1 ? `Alle ${texte.length} Texte` : 'Alle Texte'}</a></p>
    </>
  ) : (
    <p class="empty wrap">Noch keine Karten im Album. Der erste Text kommt bald.</p>
  )}
</Base>

<style>
  .intro h1 { max-width: 22ch; }
  .intro p a { color: var(--ink); }

  .lead-card { margin: 8px 0 0; }

  .stack { margin-top: clamp(48px, 7vw, 80px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: 24px 48px; }
  .stack-h { font-family: var(--display); font-weight: 400; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.025em; margin: 0; }
  .stack-h::before { content: 'Archiv'; display: block; margin-bottom: 10px; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .stack-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  @media (max-width: 760px) { .stack { grid-template-columns: 1fr; } }

  .more { margin-top: 28px; font-size: 0.9rem; font-weight: 500; }
  .more a { text-decoration: none; }
  .more a::after { content: ' →'; }
  .empty { padding-top: 48px; padding-bottom: 48px; font-size: 1.1rem; }
</style>
