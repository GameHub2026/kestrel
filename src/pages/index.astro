---
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import Reel, { type Karte } from '../components/Reel.astro';
import { alleTexte, url, jahr } from '../lib';
import termine from '../data/demnaechst.json';

const texte = await alleTexte();
const [neuester, ...rest] = texte;
const weitere = rest.slice(0, 6);
const saetze = [
  'Kestrel ist meine Sammlung. Alles, was ich spiele und schaue, landet hier mit einer Wertung von 1 bis 10.',
  'Eine Skala für Spiele, Filme und Serien. Jede Zahl bedeutet immer dasselbe, und alte Wertungen bleiben stehen.',
  'Sehe ich etwas später anders, kommt ein datierter Nachtrag dazu. So bleibt sichtbar, wie ein Eindruck gewachsen ist.',
];

// Drei Ringe wie bei der Apple Watch: je Medium füllt sich der Ring bis zur durchschnittlichen Wertung (auf ganze Zahlen gerundet).
const medien = [
  { key: 'spiel', name: 'Spiele', href: '/texte/?medium=spiel' },
  { key: 'film', name: 'Filme', href: '/texte/?medium=film' },
  { key: 'serie', name: 'Serien', href: '/texte/?medium=serie' },
].map((m, i) => {
  const liste = texte.filter((t) => t.data.medium === m.key);
  const schnitt = liste.length ? Math.round(liste.reduce((s, t) => s + t.data.wertung, 0) / liste.length) : 0;
  const r = 46 - i * 13;
  return { ...m, anzahl: liste.length, schnitt, r, u: 2 * Math.PI * r };
});

// Große Bildstrecke unter dem Kopf: je Medium eine Karte, dazu Termine und Archiv
const anz = (n: number, eins: string, viele: string) => `${n} ${n === 1 ? eins : viele}`;
const m = Object.fromEntries(medien.map((x) => [x.key, x]));
const heute = new Date().toISOString().slice(0, 10);
const kommend = (termine.eintraege as { datum: string; typ: string }[]).filter((e) => e.datum >= heute);
const jahre = new Set(texte.map((t) => jahr(t.data.datum)));
const karten: Karte[] = [
  { id: 'spiele', medium: 'spiel', eyebrow: 'Spiele', titel: 'Bis zum Abspann.', text: 'Tests und Ersteindrücke zu allem, was ich spiele. Von der ersten Stunde bis zur letzten Trophäe.',
    fakten: [m.spiel.anzahl ? anz(m.spiel.anzahl, 'Text', 'Texte') : 'Erster Test folgt bald', 'Eine Skala von 1 bis 10'], schnitt: m.spiel.anzahl ? m.spiel.schnitt : undefined, href: '/texte/?medium=spiel', knopf: 'Spiele ansehen', fokus: '74% 55%', fokusHell: '74% 60%' },
  { id: 'filme', medium: 'film', eyebrow: 'Filme', titel: 'Licht aus. Film ab.', text: 'Kritiken zu Kino und Streaming. Eine Zahl, ein Satz, und für wen es sich lohnt.',
    fakten: [m.film.anzahl ? anz(m.film.anzahl, 'Text', 'Texte') : 'Erste Kritik folgt bald', 'Kino und Streaming'], schnitt: m.film.anzahl ? m.film.schnitt : undefined, href: '/texte/?medium=film', knopf: 'Filme ansehen', fokus: '48% 50%', fokusHell: '68% 55%' },
  { id: 'serien', medium: 'serie', eyebrow: 'Serien', titel: 'Nur noch eine Folge.', text: 'Von der ersten Folge bis zum Finale. Was sich lohnt, und was man getrost auslassen kann.',
    fakten: [m.serie.anzahl ? anz(m.serie.anzahl, 'Text', 'Texte') : 'Erste Kritik folgt bald', 'Ganze Staffeln'], schnitt: m.serie.anzahl ? m.serie.schnitt : undefined, href: '/texte/?medium=serie', knopf: 'Serien ansehen', fokus: '80% 50%', fokusHell: '72% 50%' },
  { id: 'demnaechst', eyebrow: 'Demnächst', titel: 'Bald auf der Leinwand.', text: 'Kinostarts und neue Staffeln in Deutschland, jeden Tag aktuell.',
    fakten: [anz(kommend.length, 'Termin', 'Termine'), anz(kommend.filter((e) => e.datum === heute).length, 'Start heute', 'Starts heute')], href: '/demnaechst/', knopf: 'Termine ansehen', fokus: '72% 50%', fokusHell: '72% 60%' },
  { id: 'archiv', eyebrow: 'Rückblick', titel: 'Alles bleibt stehen.', text: 'Das Archiv nach Jahr und Monat. Alte Wertungen werden nie geändert, nur ergänzt.',
    fakten: [anz(texte.length, 'Text', 'Texte'), anz(jahre.size, 'Jahr', 'Jahre')], href: '/archiv/', knopf: 'Zum Archiv', fokus: '62% 50%', fokusHell: '72% 55%' },
];
---
<Base>
  <section class="held wrap" aria-labelledby="held-h">
    <svg class="ringe" viewBox="0 0 110 110" aria-hidden="true">
      {medien.map((m) => (
        <g data-medium={m.key}>
          <circle class="spur" cx="55" cy="55" r={m.r} />
          <circle class="wert" cx="55" cy="55" r={m.r} style={`--u:${m.u.toFixed(2)}; --voll:${(m.u * (1 - m.schnitt / 10)).toFixed(2)}`} />
        </g>
      ))}
    </svg>
    <p class="held-marke"><span id="held-marke">Kestrel</span></p>
    <h1 id="held-h">Ehrlich bewertet.</h1>
    <p class="unter">Was ich spiele und schaue. Eine Skala von 1 bis 10, gleich für alle drei Medien.</p>
    <p class="knoepfe">
      {neuester && <a class="btn" href={url(neuester)}>Neuesten Text lesen</a>}
      <a class="mehr" href="/texte/">Zur Sammlung</a>
    </p>
  </section>

  <Reel karten={karten} />

  {neuester && (
    <section class="neu wrap" aria-labelledby="neu-h">
      <h2 id="neu-h" class="visually-hidden">Neuester Text</h2>
      <p class="neu-eyebrow">Neu</p>
      <Ticket text={neuester} size="hero" headingLevel="h3" />
    </section>
  )}

  <!-- Satz für Satz: die Wörter werden hell, während man scrollt -->
  <section class="manifest" aria-label="Über Kestrel">
    <div class="wrap manifest-innen">
      {saetze.map((s) => <p data-aufleuchten>{s}</p>)}
      <a class="mehr" href="/wie-ich-werte/">So werte ich</a>
    </div>
  </section>

  {weitere.length > 0 && (
    <section class="stack wrap" aria-labelledby="stack-h">
      <div class="stack-kopf">
        <h2 id="stack-h">Davor geschrieben.</h2>
        <a class="mehr" href="/texte/">{texte.length > 1 ? `Alle ${texte.length} in der Sammlung` : 'Zur Sammlung'}</a>
      </div>
      <ol class="stack-list">
        {weitere.map((t) => <li><Ticket text={t} headingLevel="h3" /></li>)}
      </ol>
    </section>
  )}
  {!neuester && <p class="empty wrap">Noch keine Texte. Der erste kommt bald.</p>}
</Base>

<script>
  // „Kestrel“ wandert beim Scrollen aus dem Seitenkopf an seinen Platz oben links in der Navigation.
  // Eine Kopie fliegt fest über der Seite: Position und Größe gleiten von der Überschrift zur Navigation.
  (() => {
    const wort = document.getElementById('held-marke');
    const ziel = document.getElementById('gn-wort');
    const gn = document.getElementById('gn');
    if (!wort || !ziel || !gn) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { ziel.classList.remove('gn-wort--start'); return; }

    const flug = document.createElement('div');
    flug.className = 'marke-flug'; flug.setAttribute('aria-hidden', 'true'); flug.textContent = 'Kestrel';
    document.body.append(flug);
    wort.style.visibility = 'hidden';

    let start = { top: 0, left: 0, fs: 1 }, end = { top: 0, left: 0, s: 1 }, weg = 1, geplant = false;
    const miss = () => {
      const r = wort.getBoundingClientRect(); const t = ziel.getBoundingClientRect();
      const fs = parseFloat(getComputedStyle(wort).fontSize);
      start = { top: r.top + scrollY, left: r.left, fs };
      end = { top: t.top, left: t.left, s: parseFloat(getComputedStyle(ziel).fontSize) / fs };
      flug.style.fontSize = `${fs}px`;
      weg = Math.max(60, start.top - end.top);
      zeichne();
    };
    const sanft = (p: number) => (p < 0.5 ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2);
    const zeichne = () => {
      geplant = false;
      const p = Math.min(1, Math.max(0, scrollY / weg));
      const e = sanft(p);
      const yNatur = start.top - scrollY;
      const y = yNatur + (end.top - yNatur) * e;
      const x = start.left + (end.left - start.left) * e;
      const sc = 1 + (end.s - 1) * e;
      flug.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) scale(${sc.toFixed(4)})`;
      // Menü oder Suche offen: unterwegs ausblenden, damit nichts über dem Menü schwebt
      const offen = gn.classList.contains('menue-offen') || gn.classList.contains('suche-offen');
      flug.style.opacity = offen && p < 1 ? '0' : '1';
    };
    const plane = () => { if (!geplant) { geplant = true; requestAnimationFrame(zeichne); } };
    addEventListener('scroll', plane, { passive: true });
    addEventListener('resize', miss);
    new MutationObserver(plane).observe(gn, { attributes: true, attributeFilter: ['class'] });
    document.fonts?.ready.then(miss);
    miss();
  })();

  const woerter = [...document.querySelectorAll<HTMLElement>('[data-aufleuchten]')].flatMap((p) => {
    const teile = (p.textContent || '').split(/(\s+)/);
    p.replaceChildren(...teile.map((w) => { if (/^\s+$/.test(w)) return document.createTextNode(w); const s = document.createElement('span'); s.className = 'wort'; s.textContent = w; return s; }));
    return [...p.querySelectorAll<HTMLElement>('.wort')];
  });
  let geplant = false;
  const rechne = () => {
    geplant = false;
    const linie = innerHeight * 0.72;
    for (const w of woerter) w.classList.toggle('an', w.getBoundingClientRect().top < linie);
  };
  addEventListener('scroll', () => { if (!geplant) { geplant = true; requestAnimationFrame(rechne); } }, { passive: true });
  addEventListener('resize', rechne);
  addEventListener('load', rechne);
  rechne();
</script>

<style>
  .held { text-align: center; padding-top: clamp(48px, 8vw, 96px); padding-bottom: clamp(40px, 6vw, 72px); }
  .ringe { width: clamp(132px, 16vw, 176px); height: auto; display: block; margin: 0 auto 28px; transform: rotate(-90deg); overflow: visible; }
  .ringe circle { fill: none; stroke: var(--akzent); stroke-width: 11.5; stroke-linecap: round; }
  .ringe .spur { opacity: 0.2; }
  .ringe .wert { stroke-dasharray: var(--u); stroke-dashoffset: var(--voll); animation: zieh 1600ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  .ringe g:nth-child(2) .wert { animation-delay: 120ms; }
  .ringe g:nth-child(3) .wert { animation-delay: 240ms; }
  @keyframes zieh { from { stroke-dashoffset: var(--u); } }

  .held-marke { margin: 0 0 10px; }
  .held-marke span, :global(.marke-flug) { display: inline-block; font-size: clamp(30px, 3.6vw, 44px); font-weight: 600; letter-spacing: -0.02em; line-height: 1; white-space: nowrap; }
  :global(.marke-flug) {
    position: fixed; top: 0; left: 0; z-index: 52; pointer-events: none; color: var(--ink);
    transform-origin: 0 0; will-change: transform; transition: opacity 200ms var(--ease);
  }
  h1 { margin: 0; font-size: clamp(48px, 8vw, 96px); line-height: 1.04; font-weight: 600; letter-spacing: -0.015em; }
  .unter { margin: 14px auto 0; max-width: 24ch; font-size: clamp(21px, 2.6vw, 28px); line-height: 1.14; font-weight: 400; letter-spacing: 0.007em; text-wrap: balance; }
  .knoepfe { margin: 30px 0 0; display: flex; justify-content: center; align-items: center; gap: 14px 30px; flex-wrap: wrap; }
  .knoepfe .mehr { font-size: 17px; }


  .neu { margin-top: clamp(80px, 11vw, 140px); margin-bottom: clamp(64px, 9vw, 110px); }
  .neu-eyebrow { margin: 0 0 12px; text-align: center; font-size: 17px; font-weight: 600; color: var(--neu); }

  /* Manifest: schwarzes Band wie Apples Pro-Seiten, Wörter werden beim Scrollen hell */
  .manifest { background: var(--manifest); color: #f5f5f7; padding: clamp(96px, 16vh, 180px) 0; }
  .manifest-innen { max-width: 820px; }
  .manifest p { margin: 0 0 0.9em; font-size: clamp(28px, 4vw, 48px); line-height: 1.12; letter-spacing: -0.005em; font-weight: 600; text-wrap: pretty; }
  .manifest :global(.wort) { color: #424245; transition: color 600ms var(--ease); }
  .manifest :global(.wort.an) { color: #f5f5f7; }
  .manifest .mehr { color: #2997ff; font-size: 21px; margin-top: 12px; }

  .stack { margin-top: clamp(72px, 10vw, 120px); }
  .stack-kopf { display: flex; align-items: baseline; justify-content: space-between; gap: 12px 24px; flex-wrap: wrap; margin-bottom: 24px; }
  .stack-kopf h2 { margin: 0; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.08; font-weight: 600; letter-spacing: -0.003em; }
  .stack-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .empty { padding-top: 48px; padding-bottom: 48px; font-size: 21px; text-align: center; color: var(--ink-2); }
  @media (prefers-reduced-motion: reduce) { .manifest :global(.wort) { color: #f5f5f7; } }
</style>
