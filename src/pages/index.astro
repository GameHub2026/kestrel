---
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import Szene from '../components/Szene.astro';
import { alleTexte, url } from '../lib';

const texte = await alleTexte();
const [neuester, ...rest] = texte;
const weitere = rest.slice(0, 6);
const saetze = [
  'Kestrel ist meine Sammlung. Alles, was ich spiele und schaue, landet hier mit einer Wertung von 1 bis 10.',
  'Eine Skala für Spiele, Filme und Serien. Jede Zahl bedeutet immer dasselbe, und alte Wertungen bleiben stehen.',
  'Sehe ich etwas später anders, kommt ein datierter Nachtrag dazu. So bleibt sichtbar, wie ein Eindruck gewachsen ist.',
];
---
<Base>
  <!-- Bühne: Neonstadt über die ganze Breite; beim Scrollen steigt der neueste Text zwischen den Ebenen auf -->
  <section class="buehne" id="buehne" aria-label="Kestrel">
    <div class="buehne-innen">
      <Szene thema="stadt" art="buehne" />
      <div class="buehne-text wrap">
        <span class="kicker">Kritiken von Kevin · Spiele, Filme, Serien</span>
        <h1>Was ich spiele und schaue,<br />ehrlich bewertet.</h1>
        <p class="lead">Wertung von 1 bis 10, gleich für alle drei Medien. Sehe ich etwas später anders, kommt ein Nachtrag dazu.</p>
        <p class="knoepfe">
          {neuester && <a class="knopf" href={url(neuester)}>Neuester Text</a>}
          <a class="link" href="/texte/">Alle Texte <span aria-hidden="true">→</span></a>
        </p>
      </div>
      {neuester && (
        <div class="buehne-fenster wrap">
          <Ticket text={neuester} size="hero" />
        </div>
      )}
    </div>
  </section>

  <!-- Satz für Satz: die Wörter leuchten auf, während man scrollt -->
  <section class="manifest" aria-label="Über Kestrel">
    <div class="wrap manifest-innen">
      <span class="kicker">Über Kestrel</span>
      {saetze.map((s) => <p data-aufleuchten>{s}</p>)}
    </div>
  </section>

  {weitere.length > 0 && (
    <section class="stack wrap" aria-labelledby="stack-h">
      <h2 id="stack-h" class="stack-h">Davor geschrieben</h2>
      <ol class="stack-list">
        {weitere.map((t) => <li><Ticket text={t} headingLevel="h3" /></li>)}
      </ol>
    </section>
  )}
  {!neuester && <p class="empty wrap">Noch keine Texte. Der erste kommt bald.</p>}
  {neuester && <p class="more wrap"><a href="/texte/">{texte.length > 1 ? `Alle ${texte.length} Texte` : 'Alle Texte'}</a></p>}
</Base>

<script>
  const buehne = document.getElementById('buehne')!;
  const sz = buehne.querySelector<HTMLElement>('[data-szene]');
  let q = 0;
  const verbinde = (s: any) => { s.scrollVersatz = (tiefe: number) => q * (1 - tiefe) * 70; };
  if (sz) { if ((sz as any).szene) verbinde((sz as any).szene); else sz.addEventListener('szene-bereit', (e) => verbinde((e as CustomEvent).detail)); }

  const woerter = [...document.querySelectorAll<HTMLElement>('[data-aufleuchten]')].flatMap((p) => {
    const teile = (p.textContent || '').split(/(\s+)/);
    p.replaceChildren(...teile.map((w) => { if (/^\s+$/.test(w)) return document.createTextNode(w); const s = document.createElement('span'); s.className = 'wort'; s.textContent = w; return s; }));
    return [...p.querySelectorAll<HTMLElement>('.wort')];
  });

  let geplant = false;
  const rechne = () => {
    geplant = false;
    const r = buehne.getBoundingClientRect();
    q = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
    buehne.style.setProperty('--q', q.toFixed(4));
    // Wörter: hell, sobald sie die Linie bei 70 % der Fensterhöhe passieren
    const linie = innerHeight * 0.7;
    for (const w of woerter) { const y = w.getBoundingClientRect().top; w.classList.toggle('an', y < linie); }
  };
  addEventListener('scroll', () => { if (!geplant) { geplant = true; requestAnimationFrame(rechne); } }, { passive: true });
  addEventListener('resize', rechne);
  rechne();
</script>

<style>
  /* Bühne zieht sich unter die Kopfleiste; das Innere klebt, solange man durch die Bühne scrollt */
  .buehne { --q: 0; position: relative; height: 185vh; margin-top: calc(-1 * var(--bar)); }
  .buehne-innen { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; }
  .buehne-text {
    position: relative; z-index: 3; text-align: center; padding-top: calc(var(--bar) + 13vh);
    transform: translateY(calc(var(--q) * -12vh)); opacity: calc(1 - var(--q) * 1.5);
    text-shadow: 0 1px 24px color-mix(in srgb, var(--ground) 55%, transparent);
  }
  .buehne-text .kicker { margin-bottom: 18px; }
  .buehne-text h1 { margin: 0; font-weight: 400; font-size: clamp(2.3rem, 5.2vw, 4.4rem); line-height: 1.04; letter-spacing: -0.04em; text-wrap: balance; }
  .lead { margin: 18px auto 0; max-width: 46ch; color: var(--ink-2); font-size: clamp(0.95rem, 1.2vw, 1.05rem); line-height: 1.55; }
  .knoepfe { margin: 26px 0 0; display: flex; justify-content: center; align-items: center; gap: 18px; }
  .knopf { display: inline-flex; align-items: center; height: 40px; padding: 0 18px; border-radius: 999px; background: var(--ink); color: var(--ground); text-decoration: none; font-size: 0.9rem; font-weight: 500; text-shadow: none; }
  .knopf:hover { opacity: 0.86; }
  .link { font-size: 0.9rem; font-weight: 500; text-decoration: none; }
  .link span { display: inline-block; transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1); }
  .link:hover span { transform: translateX(4px); }

  /* Das Fenster: startet tief zwischen den Dächern und steigt beim Scrollen auf */
  .buehne-fenster {
    position: absolute; z-index: 1; left: 0; right: 0; top: 54vh;
    transform: translateY(calc((1 - var(--q)) * 27vh)) scale(calc(0.94 + var(--q) * 0.06));
    transform-origin: 50% 100%;
  }
  .buehne-fenster :global(.ticket--hero) {
    background: color-mix(in srgb, var(--paper) 90%, transparent); backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.6), 0 0 0 1px var(--line);
  }

  /* Manifest: dunkles Band, Wörter leuchten nacheinander auf */
  .manifest { position: relative; z-index: 2; background: #0c0c0d; color: #f2f1ec; padding: clamp(80px, 14vh, 160px) 0; }
  .manifest-innen { max-width: 860px; }
  .manifest .kicker { color: #8f8b84; margin-bottom: 28px; }
  .manifest p { margin: 0 0 1.1em; font-size: clamp(1.4rem, 2.7vw, 2.2rem); line-height: 1.3; letter-spacing: -0.025em; font-weight: 400; }
  .manifest :global(.wort) { color: rgb(242 241 236 / 0.16); transition: color 500ms ease; }
  .manifest :global(.wort.an) { color: rgb(242 241 236 / 1); }

  .stack { margin-top: clamp(56px, 8vw, 96px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: 24px 48px; }
  .stack-h { font-family: var(--display); font-weight: 400; font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.1; letter-spacing: -0.025em; margin: 0; }
  .stack-h::before { content: 'Archiv'; display: block; margin-bottom: 10px; font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  .stack-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  @media (max-width: 760px) {
    .stack { grid-template-columns: 1fr; }
    .buehne { height: 165vh; }
    .buehne-text { padding-top: calc(var(--bar) + 8vh); }
    .buehne-fenster { top: 50vh; }
  }
  .more { margin-top: 28px; font-size: 0.9rem; font-weight: 500; }
  .more a { text-decoration: none; }
  .more a::after { content: ' →'; }
  .empty { padding-top: 48px; padding-bottom: 48px; font-size: 1.1rem; }
  @media (prefers-reduced-motion: reduce) { .buehne { height: auto; } .buehne-innen { position: relative; } .buehne-fenster { position: relative; top: auto; transform: none; padding-bottom: 40px; } .manifest :global(.wort) { color: #f2f1ec; } }
</style>
