---
import Base from '../layouts/Base.astro';
import Szene from '../components/Szene.astro';
import { ic } from '../icons';
import daten from '../data/demnaechst.json';

type Eintrag = { id: string; art: 'film' | 'serie'; typ: string; titel: string; datum: string; text: string; bild: string | null; anbieter: string[]; link: string; info?: string };
const infos = (daten as { infos?: Record<string, unknown> }).infos || {};
const heute = new Date().toISOString().slice(0, 10);
const eintraege = (daten.eintraege as Eintrag[]).filter((e) => e.datum >= heute);
const tagFmt = new Intl.DateTimeFormat('de-DE', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const gruppen = new Map<string, Eintrag[]>();
for (const e of eintraege) {
  if (!gruppen.has(e.datum)) gruppen.set(e.datum, []);
  gruppen.get(e.datum)!.push(e);
}
// TMDB liefert einige Seriengenres nur englisch
const GENRE_DE: Record<string, string> = { 'Action & Adventure': 'Action & Abenteuer', 'Kids': 'Kinder', 'War & Politics': 'Krieg & Politik', 'News': 'Nachrichten', 'Talk': 'Talkshow', 'Soap': 'Seifenoper', 'Reality': 'Reality' };
const genresVon = (e: Eintrag) => (((infos as Record<string, { genres?: string[] }>)[e.info || '']?.genres) || []).map((g) => GENRE_DE[g] || g);
const ART = { kino: 'Film', serienstart: 'Serie', staffelstart: 'Serie', folge: 'Serie' } as Record<string, string>;
---
<Base title="Demnächst" description="Kommende Kinostarts sowie neue Serien und Staffeln bei Netflix, Prime Video, Disney+ und Co. in Deutschland.">
  <header class="page-head wrap">
    <Szene thema="wueste" />
    <h1>Demnächst</h1>
    <p>Kinostarts, neue Serien, Staffeln und Folgen in Deutschland. Täglich aktualisiert.</p>
  </header>

  <div class="dem">
    <nav class="wrap tabs" aria-label="Filter">
      <button type="button" data-f="kino" data-medium="film" aria-pressed="true"><Fragment set:html={ic('kino')} /><span>Kino</span></button>
      <button type="button" data-f="serie" data-medium="serie" aria-pressed="true"><Fragment set:html={ic('serie')} /><span>Serien</span></button>
      <!-- Genre: Knopf mit dunkler Tafel, Bewegung wie die Leiste links (gleitet auf, Inhalt kommt aus der Unschärfe) -->
      <div class="gw" id="gw">
        <button type="button" class="gw-knopf" id="gw-knopf" aria-haspopup="menu" aria-expanded="false" aria-controls="gw-tafel">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18M6 12h12M10 19h4"/></svg>
          <span id="gw-text">Genre</span>
          <svg class="gw-pfeil" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="gw-tafel" id="gw-tafel" role="menu" aria-label="Genre wählen">
          <p class="gw-kopf"><span>Genre</span><span class="gw-zahl" id="gw-zahl"></span></p>
          <ul id="gw-liste"></ul>
        </div>
      </div>
      <div class="ansicht" role="group" aria-label="Ansicht">
        <button type="button" data-ansicht="liste" aria-pressed="true" aria-label="Liste" title="Liste"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg></button>
        <button type="button" data-ansicht="kacheln" aria-pressed="false" aria-label="Kacheln" title="Kacheln"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5"/></svg></button>
      </div>
    </nav>

    <section class="wrap" aria-label="Termine" id="termine">
      {[...gruppen].map(([datum, liste]) => (
        <div class="tag" data-tag>
          <h2 class="tag-name">{tagFmt.format(new Date(datum + 'T12:00:00Z'))}</h2>
          <ul class="liste">
            {liste.map((e) => (
              <li class="eintrag" data-medium={e.art} data-f={e.typ === 'kino' ? 'kino' : 'serie'} data-genres={genresVon(e).join('|')}>
                <button type="button" class="karte" data-info={e.info} data-termin={`${tagFmt.format(new Date(e.datum + 'T12:00:00Z'))} · ${e.text}`} data-art={ART[e.typ]} data-anbieter={e.anbieter.join(' · ')} data-medium={e.art} aria-haspopup="dialog">
                  <span class="poster">{e.bild && <img src={e.bild} alt="" loading="lazy" width="56" height="84" />}</span>
                  <span class="mitte">
                    <span class="meta mono">{ART[e.typ]} · {e.text}</span>
                    <span class="titel">{e.titel}</span>
                    {e.anbieter.length > 0 && <span class="anbieter mono">{e.anbieter.join(' · ')}</span>}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      ))}
      {eintraege.length === 0 && <p class="hinweis mono">Gerade sind keine Termine geladen.</p>}
    </section>

    <section class="wrap merk" id="merk" hidden aria-labelledby="merk-h">
      <h2 id="merk-h" class="abschnitt">Auf meiner Merkliste</h2>
      <ul class="liste" id="merk-liste"></ul>
    </section>

    <dialog class="box" id="box" aria-labelledby="box-titel">
      <button type="button" class="box-zu" id="box-zu" aria-label="Schließen"><Fragment set:html={ic('zu')} /></button>
      <div class="box-kopf">
        <img class="box-bild" id="box-bild" alt="" />
        <div class="box-kern">
          <p class="meta mono" id="box-meta"></p>
          <h2 class="box-titel" id="box-titel"></h2>
          <p class="box-leit" id="box-leit"></p>
          <p class="box-termin mono" id="box-termin"></p>
          <p class="box-anbieter mono" id="box-anbieter"></p>
        </div>
      </div>
      <p class="box-genres" id="box-genres"></p>
      <p class="box-handlung" id="box-handlung"></p>
      <dl class="box-fakten" id="box-fakten"></dl>
      <p class="box-knoepfe" id="box-knoepfe"></p>
      <!-- Nur auf Kevins Geräten (Merkliste-Schlüssel im Browser): direkt merken und folgen -->
      <div class="box-merk" id="box-merk" hidden>
        <button type="button" class="mk" id="b-merk" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/></svg><span>Auf die Merkliste</span></button>
        <button type="button" class="mk" id="b-glocke" aria-pressed="false" title="Neue Staffeln oder Teile, Ableger, Termine, Trailer und News unter „Ich folge“"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg><span>Serie folgen</span></button>
        <p class="mk-hinweis mono" id="mk-hinweis" aria-live="polite"></p>
      </div>
      <section class="box-news" id="box-news" aria-labelledby="box-news-h">
        <h3 id="box-news-h" class="mono">Aktuelle News</h3>
        <ul id="box-news-liste"></ul>
      </section>
    </dialog>
    <script type="application/json" id="infos" set:html={JSON.stringify(infos)} />

    <p class="wrap quelle mono">News: Moviepilot, Serienjunkies, DWDL, Spiegel, Variety, Deadline, Hollywood Reporter, IndieWire, Collider. Termine: TMDB. Diese Seite nutzt die TMDB-API, ist aber nicht von TMDB bestätigt oder zertifiziert. Termine können sich kurzfristig ändern.</p>
  </div>
</Base>

<script>
  import { mitIcon } from '../icons';
  // Filter: setzt den Zustand jedes Mal vollständig neu (auch beim Zurückkehren auf die Seite, pageshow).
  const knoepfe = [...document.querySelectorAll<HTMLButtonElement>('[data-f]')].filter((b) => b.tagName === 'BUTTON');
  const bereich = document.getElementById('termine')!;
  const leer = document.createElement('p');
  leer.className = 'leer mono'; leer.textContent = 'Dazu steht gerade nichts an.';
  // Genre-Tafel: zeigt die Genres, die im gewählten Bereich (Kino und/oder Serien) vorkommen
  const gw = document.getElementById('gw')!, gwKnopf = document.getElementById('gw-knopf')!, gwListe = document.getElementById('gw-liste')!;
  let genre = '';
  const alleLi = [...bereich.querySelectorAll<HTMLElement>('.eintrag')];
  const genresVonLi = (li: HTMLElement) => (li.dataset.genres || '').split('|').filter(Boolean);
  function genreLeiste(f: string) {
    const zahl = new Map<string, number>();
    const imBereich = alleLi.filter((li) => f === 'alle' || li.dataset.f === f);
    imBereich.forEach((li) => genresVonLi(li).forEach((g) => zahl.set(g, (zahl.get(g) || 0) + 1)));
    if (genre && !zahl.has(genre)) genre = '';
    const punkt = (wert: string, text: string, n: number, i: number) => {
      const li = document.createElement('li'); li.style.setProperty('--i', String(i));
      const b = document.createElement('button'); b.type = 'button'; b.setAttribute('role', 'menuitemradio'); b.setAttribute('aria-checked', String(genre === wert)); b.tabIndex = -1;
      const t = document.createElement('span'); t.textContent = text;
      const z = document.createElement('span'); z.className = 'n'; z.textContent = String(n);
      b.append(t, z);
      b.addEventListener('click', () => { genre = wert; schliessen(true); anwenden(aktuell()); });
      li.append(b); return li;
    };
    const sortiert = [...zahl].sort((a, b) => a[0].localeCompare(b[0], 'de'));
    gwListe.replaceChildren(punkt('', 'Alle Genres', imBereich.length, 0), ...sortiert.map(([g, n], i) => punkt(g, g, n, i + 1)));
    gwListe.classList.toggle('zwei', sortiert.length > 7);
    document.getElementById('gw-text')!.textContent = genre || 'Genre';
    document.getElementById('gw-zahl')!.textContent = `${sortiert.length}`;
    gw.classList.toggle('aktiv', !!genre);
  }
  let zu = 0;
  function oeffnen() {
    clearTimeout(zu); if (gw.classList.contains('offen')) return;
    gw.classList.add('offen'); gwKnopf.setAttribute('aria-expanded', 'true');
    gwListe.querySelectorAll<HTMLButtonElement>('button').forEach((b) => (b.tabIndex = 0));
  }
  function schliessen(sofort = false) {
    clearTimeout(zu);
    zu = window.setTimeout(() => {
      gw.classList.remove('offen'); gwKnopf.setAttribute('aria-expanded', 'false');
      gwListe.querySelectorAll<HTMLButtonElement>('button').forEach((b) => (b.tabIndex = -1));
    }, sofort ? 0 : 260);
  }
  gwKnopf.addEventListener('click', () => (gw.classList.contains('offen') ? schliessen(true) : (oeffnen(), gwListe.querySelector<HTMLButtonElement>('[aria-checked="true"]')?.focus({ preventScroll: true }))));
  if (matchMedia('(hover: hover)').matches) { gw.addEventListener('mouseenter', oeffnen); gw.addEventListener('mouseleave', () => schliessen()); }
  document.addEventListener('click', (e) => { if (!gw.contains(e.target as Node)) schliessen(true); });
  gw.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { schliessen(true); gwKnopf.focus(); }
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault(); if (!gw.classList.contains('offen')) oeffnen();
      const alle = [...gwListe.querySelectorAll<HTMLButtonElement>('button')];
      const i = alle.indexOf(document.activeElement as HTMLButtonElement);
      alle[(i + (e.key === 'ArrowDown' ? 1 : -1) + alle.length) % alle.length]?.focus();
    }
  });
  gw.addEventListener('focusout', (e) => { if (!gw.contains(e.relatedTarget as Node)) schliessen(true); });
  // Kino und Serien sind zwei Schalter; beide an = alles. Der letzte aktive lässt sich nicht abschalten.
  function anwenden(f: string) {
    knoepfe.forEach((x) => x.setAttribute('aria-pressed', String(f === 'alle' || x.dataset.f === f)));
    genreLeiste(f);
    let sichtbar = 0;
    bereich.querySelectorAll<HTMLElement>('[data-tag]').forEach((tag) => {
      let n = 0;
      tag.querySelectorAll<HTMLElement>('.eintrag').forEach((li) => {
        const zeigen = (f === 'alle' || li.dataset.f === f) && (!genre || genresVonLi(li).includes(genre));
        li.hidden = !zeigen; if (zeigen) n++;
      });
      tag.hidden = n === 0; sichtbar += n;
    });
    if (sichtbar === 0 && bereich.querySelector('[data-tag]')) bereich.append(leer); else leer.remove();
  }
  const aktuell = () => { const an = knoepfe.filter((b) => b.getAttribute('aria-pressed') === 'true'); return an.length === 1 ? an[0].dataset.f! : 'alle'; };
  knoepfe.forEach((b) => b.addEventListener('click', () => {
    const an = new Set(knoepfe.filter((x) => x.getAttribute('aria-pressed') === 'true').map((x) => x.dataset.f!));
    const f = b.dataset.f!;
    if (an.has(f)) { if (an.size === 1) return; an.delete(f); } else an.add(f);
    anwenden(an.size === 1 ? [...an][0] : 'alle');
  }));
  const ausAdresse = new URLSearchParams(location.search).get('f');
  anwenden(ausAdresse === 'kino' || ausAdresse === 'serie' ? ausAdresse : 'alle');
  window.addEventListener('pageshow', (e) => { if (e.persisted) anwenden(aktuell()); });

  // Ansicht: Liste oder Kacheln (gemerkt pro Gerät)
  const termine = document.getElementById('termine')!;
  const ansichtKnoepfe = [...document.querySelectorAll<HTMLButtonElement>('[data-ansicht]')];
  function setzeAnsicht(a: string) {
    termine.classList.toggle('kacheln', a === 'kacheln');
    ansichtKnoepfe.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.ansicht === a)));
    try { localStorage.setItem('kestrel-dem-ansicht', a); } catch {}
  }
  ansichtKnoepfe.forEach((b) => b.addEventListener('click', () => setzeAnsicht(b.dataset.ansicht!)));
  try { if (localStorage.getItem('kestrel-dem-ansicht') === 'kacheln') setzeAnsicht('kacheln'); } catch {}

  // Info-Box: Klick auf einen Titel öffnet Details, Trailer, TMDB-Link und aktuelle News
  type Info = { sprache?: string; titel: string; original?: string; leitsatz?: string; handlung?: string; genres: string[]; fakten: [string, string][]; trailer?: string; link: string; bild?: string; news: { quelle: string; titel: string; link: string; datum: string }[] };
  const INFOS: Record<string, Info> = JSON.parse(document.getElementById('infos')!.textContent || '{}');
  const box = document.getElementById('box') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  const neu = (t: string, c?: string, x?: string) => { const n = document.createElement(t); if (c) n.className = c; if (x != null) n.textContent = x; return n; };
  const relativ = (iso: string) => { const t = Math.floor((Date.now() - Date.parse(iso)) / 864e5); return t <= 0 ? 'heute' : t === 1 ? 'gestern' : `vor ${t} Tagen`; };
  document.querySelectorAll<HTMLButtonElement>('.karte').forEach((k) => k.addEventListener('click', () => {
    const i = INFOS[k.dataset.info || ''];
    if (!i) return;
    box.dataset.medium = k.dataset.medium || '';
    const img = $('box-bild') as HTMLImageElement; img.hidden = !i.bild; if (i.bild) img.src = i.bild;
    $('box-meta').textContent = `${k.dataset.art}${i.original && i.original !== i.titel ? ` · ${i.original}` : ''}`;
    $('box-titel').textContent = i.titel;
    $('box-leit').textContent = i.leitsatz || ''; $('box-leit').hidden = !i.leitsatz;
    $('box-termin').textContent = k.dataset.termin || '';
    $('box-anbieter').textContent = k.dataset.anbieter ? `Bei ${k.dataset.anbieter}` : ''; $('box-anbieter').hidden = !k.dataset.anbieter;
    $('box-genres').replaceChildren(...i.genres.map((g) => neu('span', 'genre mono', g)));
    $('box-handlung').textContent = i.handlung ? `${i.handlung}${i.sprache === 'en' ? ' (Beschreibung bisher nur auf Englisch)' : ''}` : 'Noch keine Beschreibung vorhanden.';
    $('box-fakten').replaceChildren(...i.fakten.map(([a, b]) => { const d = neu('div'); d.append(neu('dt', 'mono', a), neu('dd', '', b)); return d; }));
    const kn = $('box-knoepfe'); kn.replaceChildren();
    const link = (txt: string, href: string, cls: string, icon: string) => { const a = mitIcon(neu('a', cls) as HTMLAnchorElement, icon, txt); a.href = href; a.target = '_blank'; a.rel = 'noopener'; kn.append(a); };
    if (i.trailer) link('Trailer ansehen', i.trailer, 'knopf', 'trailer');
    link('Mehr bei TMDB', i.link, 'knopf leise', 'extern');
    const nl = $('box-news-liste'); nl.replaceChildren();
    for (const n of i.news) {
      const li = neu('li'); const a = neu('a', '', n.titel) as HTMLAnchorElement; a.href = n.link; a.target = '_blank'; a.rel = 'noopener';
      li.append(a, neu('span', 'mono', `${n.quelle} · ${relativ(n.datum)}`)); nl.append(li);
    }
    if (!i.news.length) nl.append(neu('li', 'leer mono', 'Gerade keine aktuellen Meldungen.'));
    zeigeMerk(k.dataset.info || '', k.dataset.medium || '');
    box.showModal();
  }));
  $('box-zu').addEventListener('click', () => box.close());
  box.addEventListener('click', (e) => { if (e.target === box) box.close(); }); // Klick neben die Box schließt

  // Direkt merken und folgen (nur mit Merkliste-Schlüssel auf diesem Gerät)
  type ME = { id: string };
  let token = ''; try { token = localStorage.getItem('kestrel-merk-token') || ''; } catch {}
  let meine = new Map<string, ME>();
  let folgeIch = new Set<string>();
  const idAus = (info: string) => info.replace(/^movie-/, 'tmdb-movie:').replace(/^tv-/, 'tmdb-tv:');
  const infoAus = (id: string) => id.replace('tmdb-movie:', 'movie-').replace('tmdb-tv:', 'tv-');
  const kopf = () => ({ 'x-merk-token': token, 'content-type': 'application/json' });
  async function merkApi(opt: RequestInit = {}) {
    const r = await fetch('/api/merk', { ...opt, headers: kopf() });
    if (!r.ok) throw new Error(r.status === 401 ? 'Kein Zugang' : 'Fehler');
    const l: ME[] = await r.json(); meine = new Map(l.map((e) => [e.id, e])); markiereKarten();
  }
  async function serienLaden(opt: RequestInit = {}) {
    const r = await fetch('/api/serien', { ...opt, headers: kopf() });
    if (!r.ok) throw new Error(r.status === 401 ? 'Kein Zugang' : 'Fehler');
    const d: { serien: { id: string; aus?: boolean }[] } = await r.json();
    folgeIch = new Set(d.serien.filter((x) => !x.aus).map((x) => x.id)); markiereKarten();
  }
  // Karten-Zeichen: Glocke, wenn ich folge, sonst Lesezeichen, wenn gemerkt
  function markiereKarten() {
    document.querySelectorAll<HTMLButtonElement>('.karte').forEach((k) => {
      const id = idAus(k.dataset.info || '');
      k.dataset.gemerkt = folgeIch.has(id) ? 'auge' : meine.has(id) ? 'ja' : '';
    });
  }
  let aktiv = { id: '', medium: '' };
  function zeigeMerk(info: string, medium: string) {
    const bereich = $('box-merk'); bereich.hidden = !token || !info; if (bereich.hidden) return;
    aktiv = { id: idAus(info), medium };
    const bm = $('b-merk'), bg = $('b-glocke');
    const gemerkt = meine.has(aktiv.id), folge = folgeIch.has(aktiv.id);
    bm.setAttribute('aria-pressed', String(gemerkt)); bm.querySelector('span')!.textContent = gemerkt ? 'Auf der Merkliste' : 'Auf die Merkliste';
    bg.setAttribute('aria-pressed', String(folge)); bg.querySelector('span')!.textContent = folge ? 'Folge ich' : medium === 'film' ? 'Film folgen' : 'Serie folgen';
    $('mk-hinweis').textContent = '';
  }
  $('b-merk').addEventListener('click', async () => {
    if (meine.has(aktiv.id)) { location.href = '/merkliste/'; return; }
    const hinweis = $('mk-hinweis'); hinweis.textContent = 'Speichere …';
    try { await merkApi({ method: 'POST', body: JSON.stringify({ id: aktiv.id, medium: aktiv.medium }) }); zeigeMerk(infoAus(aktiv.id), aktiv.medium); $('mk-hinweis').textContent = 'Gemerkt.'; }
    catch (err) { hinweis.textContent = `Ging nicht: ${(err as Error).message}`; }
  });
  $('b-glocke').addEventListener('click', async () => {
    const hinweis = $('mk-hinweis'); hinweis.textContent = 'Speichere …';
    const folge = folgeIch.has(aktiv.id);
    try {
      await serienLaden({ method: folge ? 'PATCH' : 'POST', body: JSON.stringify(folge ? { id: aktiv.id, aus: true } : { id: aktiv.id, titel: $('box-titel').textContent }) });
      zeigeMerk(infoAus(aktiv.id), aktiv.medium);
      const film = aktiv.medium === 'film';
      $('mk-hinweis').textContent = folge ? `Du folgst ${film ? 'dem Film' : 'der Serie'} nicht mehr.`
        : film ? 'Neue Teile, Ableger, Kinostart, Trailer und News stehen ab jetzt unter „Ich folge“.' : 'Neue Staffeln, Ableger, Termine, Trailer und News stehen ab jetzt unter „Ich folge“.';
      try { sessionStorage.removeItem('kestrel-neu'); } catch {}
    } catch (err) { hinweis.textContent = `Ging nicht: ${(err as Error).message}`; }
  });
  if (token) { merkApi().catch(() => {}); serienLaden().catch(() => {}); }

  // Meine Merkliste (öffentliche Einträge, nur lesen)
  type M = { medium: string; titel: string; bild?: string; status?: string; termine: { datum: string; text: string }[] };
  const el = (t: string, c?: string, x?: string) => { const n = document.createElement(t); if (c) n.className = c; if (x != null) n.textContent = x; return n; };
  const datumDe = (d: string) => new Date(d + 'T12:00:00').toLocaleDateString('de-DE', { weekday: 'short', day: '2-digit', month: '2-digit', year: 'numeric' });
  const MEDIUM: Record<string, string> = { spiel: 'Spiel', film: 'Film', serie: 'Serie' };
  fetch('/api/oeffentlich').then((r) => r.json()).then((d: M[]) => {
    if (!Array.isArray(d) || !d.length) return;
    const ul = document.getElementById('merk-liste')!;
    for (const e of d.sort((a, b) => (a.termine[0]?.datum || '9999').localeCompare(b.termine[0]?.datum || '9999'))) {
      const li = el('li', 'eintrag'); li.dataset.medium = e.medium;
      const poster = el('span', 'poster'); if (e.bild) { const i = document.createElement('img'); i.src = e.bild; i.alt = ''; i.loading = 'lazy'; poster.append(i); }
      const mitte = el('div', 'mitte'); const n = e.termine[0];
