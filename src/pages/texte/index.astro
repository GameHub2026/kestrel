---
import Base from '../../layouts/Base.astro';
import Ticket from '../../components/Ticket.astro';
import { MEDIUM, TEXTFORM } from '../../wertung';
import { alleTexte, jahr } from '../../lib';

const texte = await alleTexte();
const jahre = [...new Set(texte.map((t) => jahr(t.data.datum)))];
const gruppen = [
  { name: 'medium', label: 'Medium', werte: Object.entries(MEDIUM) },
  { name: 'textform', label: 'Textform', werte: Object.entries(TEXTFORM) },
  { name: 'jahr', label: 'Jahr', werte: jahre.map((j) => [String(j), String(j)]) },
];
---
<Base title="Alle Texte" description="Alle Tests, Kurzkritiken, Ersteindrücke und Rückblicke zu Spielen, Filmen und Serien, filterbar nach Medium, Textform und Jahr.">
  <header class="page-head wrap">
    <h1>Alle Texte</h1>
    <p>Jede Karte ein Text. Filtern nach Medium, Textform oder Jahr.</p>
  </header>

  {texte.length === 0 && <p class="none wrap">Noch keine Karten im Album. Der erste Text kommt bald.</p>}
  <form class="filter wrap" aria-label="Texte filtern" hidden={texte.length === 0}>
    {gruppen.map((g) => (
      <fieldset>
        <legend class="mono">{g.label}</legend>
        <label><input type="radio" name={g.name} value="" checked /><span>Alle</span></label>
        {g.werte.map(([v, l]) => (
          <label data-medium={g.name === 'medium' ? v : undefined}><input type="radio" name={g.name} value={v} /><span>{l}</span></label>
        ))}
      </fieldset>
    ))}
    <p class="count mono" aria-live="polite"><span id="anzahl">{texte.length}</span> von {texte.length} Karten</p>
  </form>

  <ol class="list wrap" id="liste">
    {texte.map((t) => (
      <li data-medium={t.data.medium} data-textform={t.data.textform} data-jahr={jahr(t.data.datum)}>
        <Ticket text={t} />
      </li>
    ))}
  </ol>
  <p class="none wrap" id="leer" hidden>Keine Karte passt zu diesem Filter. <button type="button" id="reset">Filter zurücksetzen</button></p>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.filter')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('#liste > li')];
  const anzahl = document.getElementById('anzahl')!;
  const leer = document.getElementById('leer')!;
  const namen = ['medium', 'textform', 'jahr'];

  function apply(push = true) {
    const fd = new FormData(form);
    let n = 0;
    for (const li of items) {
      const ok = namen.every((k) => !fd.get(k) || li.dataset[k] === fd.get(k));
      li.hidden = !ok;
      if (ok) n++;
    }
    anzahl.textContent = String(n);
    leer.hidden = n > 0 || items.length === 0;
    if (push) {
      const q = new URLSearchParams();
      for (const k of namen) if (fd.get(k)) q.set(k, String(fd.get(k)));
      history.replaceState(null, '', q.size ? `?${q}` : location.pathname);
    }
  }
  // Filter aus der Adresse übernehmen (teilbare Links wie /texte/?medium=film)
  const start = new URLSearchParams(location.search);
  for (const k of namen) {
    const v = start.get(k);
    const input = v && form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(v)}"]`);
    if (input) input.checked = true;
  }
  form.addEventListener('change', () => apply());
  document.getElementById('reset')!.addEventListener('click', () => { form.reset(); apply(); });
  apply(false);
</script>

<style>
  .filter[hidden] { display: none; }
  .filter { display: flex; flex-wrap: wrap; gap: 18px 36px; align-items: end; margin-bottom: 32px; }
  fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  legend { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-2); margin-bottom: 8px; font-weight: 600; }
  label { position: relative; cursor: pointer; }
  label input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  /* Jede Option ist ein kleiner Abriss; gewählt = gelocht */
  label span {
    display: inline-flex; align-items: center; gap: 10px; font-family: var(--display); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.04em; font-size: 1.05rem; padding: 7px 14px 6px 10px; background: var(--paper); color: var(--ink);
    border-radius: 4px; box-shadow: var(--shadow);
    transition: background-color 160ms, color 160ms, transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  label span::before {
    content: ''; width: 10px; height: 10px; border-radius: 50%; flex: none;
    border: 1.5px dashed currentColor; opacity: 0.6;
  }
  label:hover span { transform: translateY(-2px); }
  label input:checked + span { background: var(--ink); color: var(--ground); }
  label input:checked + span::before { border: 0; background: var(--ground); opacity: 1; box-shadow: inset 0 2px 2px rgb(0 0 0 / 0.35); }
  label[data-medium] input:checked + span { background: var(--card); color: var(--card-ink); }
  label input:focus-visible + span { outline: 3px solid var(--focus); outline-offset: 3px; }
  .count { margin: 0 0 6px auto; font-size: 0.8rem; color: var(--ink-2); }

  .list { list-style: none; margin: 0 auto; padding-top: 0; padding-bottom: 0; display: grid; gap: 14px; }
  .none { padding-top: 32px; padding-bottom: 32px; font-size: 1.1rem; }
  .none button {
    font: inherit; font-family: var(--display); font-weight: 800; text-transform: uppercase; background: var(--ink); color: var(--ground);
    border: 0; border-radius: 4px; padding: 6px 12px; cursor: pointer; margin-left: 8px;
  }
  @media (max-width: 720px) { .count { margin-left: 0; width: 100%; } }
</style>
