---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Ticket from '../../components/Ticket.astro';
import Szene from '../../components/Szene.astro';
import { SKALA, MEDIUM, TEXTFORM, STAND } from '../../wertung';
import { alleTexte, datumLang, url, nummer, type Text } from '../../lib';

export async function getStaticPaths() {
  const texte = await alleTexte();
  return texte.map((text, i) => ({
    params: { id: text.id },
    props: { text, neuer: texte[i - 1], aelter: texte[i + 1] },
  }));
}
const { text, neuer, aelter } = Astro.props as { text: Text; neuer?: Text; aelter?: Text };
const d = text.data;
const { Content } = await render(text);
const geschaut = d.medium === 'spiel' ? 'Gespielt' : 'Geschaut';
const fakten: [string, string][] = [
  ['Medium', MEDIUM[d.medium]],
  ['Textform', TEXTFORM[d.textform]],
  ...(d.plattform ? [['Plattform', d.plattform] as [string, string]] : []),
  [geschaut, d.gespielt_geschaut],
  ...(d.spielzeit ? [[d.medium === 'spiel' ? 'Spielzeit' : 'Dauer', d.spielzeit] as [string, string]] : []),
  ['Stand', STAND[d.stand]],
  ['Veröffentlicht', datumLang(d.datum)],
  ['Karte', nummer(text.nr)],
];
const beschreibung = `${MEDIUM[d.medium]}-${TEXTFORM[d.textform]}: ${d.titel}. Wertung ${d.wertung}/10. ${d.fazit}`;
---
<Base title={`${d.titel} (${TEXTFORM[d.textform]})`} description={beschreibung}>
  <div class="wrap top">
    <Szene thema={d.medium === 'film' ? 'stadt' : d.medium === 'serie' ? 'gewitter' : 'ruinen'} />
    <Ticket text={text} size="hero" link={false} tear headingLevel="h1" />
  </div>

  <div class="wrap who-phone" data-medium={d.medium}>
    <div class="who">
      <h2>Für wen?</h2>
      <p>{d.fuer_wen}</p>
    </div>
  </div>

  <div class="wrap layout" data-medium={d.medium}>
    <aside class="back" aria-label="Steckbrief">
      <h2 class="back-h">Steckbrief</h2>
      <dl>
        {fakten.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
      <div class="verdict">
        <p class="verdict-score"><span class="display">{d.wertung}</span><span class="mono">/10</span></p>
        <p class="verdict-say">{SKALA[d.wertung]}</p>
        <a class="verdict-link mono" href="/wie-ich-werte/">So werte ich</a>
      </div>
      <div class="who who-wide">
        <h2>Für wen?</h2>
        <p>{d.fuer_wen}</p>
      </div>
    </aside>

    <div class="read">
      {d.bild && (
        <figure class="motiv">
          <Image src={d.bild} alt={`Bild zu ${d.titel}`} widths={[340, 680]} sizes="340px" />
          {d.bild_quelle && <figcaption class="mono">Bild: {d.bild_quelle}</figcaption>}
        </figure>
      )}
      <div class="prose"><Content /></div>

      {d.nachtraege && d.nachtraege.length > 0 && (
        <section class="nachtraege" aria-labelledby="nt-h">
          <h2 id="nt-h">Nachträge</h2>
          <p class="nt-note">Die Wertung oben gilt seit {datumLang(d.datum)}. Spätere Gedanken stehen hier.</p>
          <ol>
            {d.nachtraege.map((n) => (
              <li>
                <span class="stamp mono">Nachtrag<br /><strong>{datumLang(n.datum)}</strong></span>
                <p>{n.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </div>

  {(neuer || aelter) && (
    <div class="wrap"><nav class="pager" aria-label="Weitere Texte">
      {aelter ? <a href={url(aelter)} rel="prev"><span class="mono">Älter</span>{aelter.data.titel}</a> : <span />}
      {neuer && <a href={url(neuer)} rel="next" class="next"><span class="mono">Neuer</span>{neuer.data.titel}</a>}
    </nav></div>
  )}
</Base>

<style>
  .top { position: relative; padding-top: clamp(120px, 22vh, 220px); }
  .top > :global(.ticket) { position: relative; z-index: 1; }
  .layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(28px, 4vw, 44px); align-items: start;
  }
  .back { grid-column: 2; grid-row: 1; position: sticky; top: 24px; display: grid; gap: 18px; }
  .read { grid-column: 1; grid-row: 1; min-width: 0; }

  .back-h, .who h2, .nachtraege h2 {
    font-family: var(--display); font-weight: 800; letter-spacing: 0.01em; text-transform: uppercase;
    font-size: 1.1rem; margin: 0;
  }
  .back { background: var(--paper); padding: 30px 22px 22px; border-radius: 0 0 6px 6px; box-shadow: inset 0 3px 0 var(--akzent), var(--shadow); }
  dl { margin: 0; display: grid; gap: 0; }
  dl div { display: grid; grid-template-columns: 7.5rem 1fr; gap: 10px; padding: 8px 0; border-bottom: 1px dashed color-mix(in srgb, var(--ink) 30%, transparent); }
  dt { font-family: var(--mono); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); padding-top: 3px; }
  dd { margin: 0; font-size: 0.98rem; }
  .verdict { display: grid; gap: 4px; }
  .verdict-score { margin: 0; display: flex; align-items: baseline; gap: 6px; }
  .verdict-score .display { font-size: 3.2rem; line-height: 0.8; }
  .verdict-score .mono { font-size: 0.9rem; color: var(--ink-2); }
  .verdict-say { margin: 0; font-weight: 600; }
  .verdict-link { font-size: 0.8rem; color: var(--ink-2); }
  .who { margin: 0 -22px -22px; padding: 18px 22px 22px; border-top: 1px dashed var(--rule); }
  .who p { margin: 6px 0 0; font-size: 1.05rem; line-height: 1.45; }
  .who-phone { display: none; }

  .motiv { margin: 0 0 32px; max-width: 340px; } /* Titelbild bewusst klein, der Text soll führen */
  .motiv :global(img) { border-radius: 4px; box-shadow: var(--shadow); width: 100%; }
  .motiv figcaption { font-size: 0.75rem; color: var(--ink-2); margin-top: 8px; }

  .prose { max-width: var(--measure); font-size: 1.15rem; line-height: 1.68; }
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose :global(h2) {
    font-family: var(--display); font-weight: 800; font-size: 1.5rem; line-height: 1;
    margin: 1.6em 0 0.5em; letter-spacing: 0.01em; text-transform: uppercase;
  }
  .prose :global(h3) { font-size: 1.25rem; margin: 1.6em 0 0.4em; }
  .prose :global(blockquote) {
    margin: 1.6em 0; padding: 0; font-family: var(--display); text-transform: uppercase; font-weight: 800;
    font-size: clamp(1.35rem, 2.6vw, 1.8rem); line-height: 1.05; color: var(--ink); text-wrap: balance;
  }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(blockquote)::before { content: ''; display: block; width: 64px; border-top: 2px solid var(--akzent); margin-bottom: 14px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; margin: 0 0 1.1em; }
  .prose :global(li) { margin-bottom: 0.35em; }
  .prose :global(li::marker) { color: var(--ink-2); }
  .prose :global(img) { border-radius: 4px; margin: 1.6em 0; max-height: 520px; width: auto; max-width: 100%; box-shadow: var(--shadow); }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(hr) { border: 0; border-top: 2px dashed var(--rule); margin: 2em 0; }

  .nachtraege { margin-top: 56px; max-width: var(--measure); }
  .nt-note { color: var(--ink-2); margin: 8px 0 20px; }
  .nachtraege ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .nachtraege li { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: start; }
  .nachtraege li p { margin: 4px 0 0; }
  .stamp {
    display: inline-block; color: var(--stamp); border: 2.5px solid var(--stamp); border-radius: 4px;
    padding: 6px 10px; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; line-height: 1.35;
    transform: rotate(-4deg); text-align: center; opacity: 0.92;
  }
  .stamp strong { font-size: 0.82rem; letter-spacing: 0.04em; }

  .pager { display: flex; justify-content: space-between; gap: 20px; margin-top: 64px; padding-top: 24px; border-top: 2px dashed var(--rule); }
  .pager a {
    display: grid; gap: 4px; text-decoration: none; font-family: var(--display); text-transform: uppercase; font-weight: 800; font-size: 1.35rem; line-height: 1; max-width: 45%;
  }
  .pager a:hover { text-decoration: underline; }
  .pager .mono { font-family: var(--mono); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.1em; color: var(--ink-2); }
  .pager .next { text-align: right; margin-left: auto; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .back { grid-column: 1; grid-row: 1; position: static; }
    /* Am Handy steht „Für wen?“ direkt unter der Karte; Wertung steht schon auf der Karte */
    .who-wide, .verdict { display: none; }
    .who-phone { display: block; margin-top: 20px; }
    .who-phone .who { margin: 0; border-radius: 6px; box-shadow: var(--shadow); }
    .layout { margin-top: 28px; }
    .read { grid-row: 2; }
  }
  @media (max-width: 480px) {
    .nachtraege li { grid-template-columns: 1fr; gap: 10px; }
    .stamp { justify-self: start; }
  }
</style>
