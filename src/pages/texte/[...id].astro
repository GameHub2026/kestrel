---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Ring from '../../components/Ring.astro';
import { SKALA, MEDIUM, TEXTFORM, STAND } from '../../wertung';
import { alleTexte, datumLang, url, nummer, type Text } from '../../lib';

export async function getStaticPaths() {
  const texte = await alleTexte();
  return texte.map((text, i) => ({
    params: { id: text.id },
    props: { text, neuer: texte[i - 1], aelter: texte[i + 1] },
  }));
}
const { text, neuer, aelter } = Astro.props as { text: Text; neuer?: Text; aelter?: Text };
const d = text.data;
const { Content } = await render(text);
const geschaut = d.medium === 'spiel' ? 'Gespielt' : 'Geschaut';
const fakten: [string, string][] = [
  ['Medium', MEDIUM[d.medium]],
  ['Textform', TEXTFORM[d.textform]],
  ...(d.plattform ? [['Plattform', d.plattform] as [string, string]] : []),
  [geschaut, d.gespielt_geschaut],
  ...(d.spielzeit ? [[d.medium === 'spiel' ? 'Spielzeit' : 'Dauer', d.spielzeit] as [string, string]] : []),
  ['Stand', STAND[d.stand]],
  ['Veröffentlicht', datumLang(d.datum)],
  ['Nummer', nummer(text.nr)],
];
const beschreibung = `${MEDIUM[d.medium]}-${TEXTFORM[d.textform]}: ${d.titel}. Wertung ${d.wertung}/10. ${d.fazit}`;
---
<Base title={`${d.titel} (${TEXTFORM[d.textform]})`} description={beschreibung}>
  <article class="artikel" data-medium={d.medium}>
    <header class="kopf wrap">
      <p class="eyebrow"><span class="punkt" aria-hidden="true"></span>{MEDIUM[d.medium]} · {TEXTFORM[d.textform]}</p>
      <p class="datum"><time datetime={d.datum.toISOString().slice(0, 10)}>{datumLang(d.datum)}</time></p>
      <h1>{d.titel}</h1>
      <p class="fazit">{d.fazit}</p>
    </header>

    <!-- Urteil zuerst: Ring, Satz zur Zahl und „Für wen?“ stehen vor dem Fließtext -->
    <section class="urteil wrap" aria-label="Urteil">
      <div class="urteil-kachel">
        <Ring wertung={d.wertung} medium={d.medium} groesse={132} zeichnen />
        <div class="urteil-text">
          <p class="u-zahl">Wertung: {d.wertung} von 10</p>
          <p class="u-satz">{SKALA[d.wertung]}</p>
          <a class="mehr" href="/wie-ich-werte/">So werte ich</a>
        </div>
        <div class="fuer-wen">
          <h2>Für wen?</h2>
          <p>{d.fuer_wen}</p>
        </div>
      </div>
    </section>

    <div class="lesen wrap">
      {d.bild && (
        <figure class="motiv">
          <Image src={d.bild} alt={`Bild zu ${d.titel}`} widths={[340, 680]} sizes="340px" />
          {d.bild_quelle && <figcaption>Bild: {d.bild_quelle}</figcaption>}
        </figure>
      )}
      <div class="prose"><Content /></div>

      {d.nachtraege && d.nachtraege.length > 0 && (
        <section class="nachtraege" aria-labelledby="nt-h">
          <h2 id="nt-h">Nachträge</h2>
          <p class="nt-note">Die Wertung oben gilt seit {datumLang(d.datum)}. Spätere Gedanken stehen hier.</p>
          <ol>
            {d.nachtraege.map((n) => (
              <li>
                <time datetime={n.datum.toISOString().slice(0, 10)}>{datumLang(n.datum)}</time>
                <p>{n.text}</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Steckbrief wie Apples „Technische Daten“: Bezeichnung links, Wert rechts, feine Linien -->
      <section class="steckbrief" aria-labelledby="sb-h">
        <h2 id="sb-h">Steckbrief</h2>
        <dl>
          {fakten.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
          <div><dt>Wertung</dt><dd>{d.wertung} von 10 · {SKALA[d.wertung]}</dd></div>
        </dl>
      </section>
    </div>
  </article>

  {(neuer || aelter) && (
    <nav class="pager wrap" aria-label="Weitere Texte">
      {aelter ? <a href={url(aelter)} rel="prev" data-medium={aelter.data.medium}><span class="p-was">Älterer Text</span><span class="p-titel">{aelter.data.titel}</span></a> : <span />}
      {neuer && <a href={url(neuer)} rel="next" class="next" data-medium={neuer.data.medium}><span class="p-was">Neuerer Text</span><span class="p-titel">{neuer.data.titel}</span></a>}
    </nav>
  )}
</Base>

<style>
  .kopf { max-width: calc(var(--measure) + 2 * var(--gutter)); padding-top: clamp(44px, 7vw, 80px); }
  @media (min-width: 1069px) { .kopf { width: var(--measure); } }
  .eyebrow { margin: 0; display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.02em; }
  .punkt { width: 7px; height: 7px; border-radius: 50%; background: var(--akzent); }
  .datum { margin: 6px 0 0; font-size: 14px; color: var(--ink-2); }
  h1 { margin: 18px 0 0; font-size: clamp(36px, 5.4vw, 56px); line-height: 1.07; font-weight: 600; letter-spacing: -0.005em; text-wrap: balance; }
  .fazit { margin: 18px 0 0; font-size: clamp(21px, 2.4vw, 24px); line-height: 1.33; color: var(--ink-2); font-weight: 400; letter-spacing: 0.009em; }

  .urteil { margin-top: clamp(36px, 5vw, 56px); }
  .urteil-kachel {
    display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1.15fr); gap: 28px 36px; align-items: center;
    padding: clamp(28px, 4vw, 44px); border-radius: var(--radius-lg); background: var(--tile);
  }
  .u-zahl, .fuer-wen h2 { margin: 0 0 6px; font-size: 12px; font-weight: 600; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.02em; }
  .u-satz { margin: 0 0 10px; font-size: 24px; line-height: 1.24; font-weight: 600; text-wrap: balance; }
  .fuer-wen { padding-left: 36px; border-left: 1px solid var(--line); }
  .fuer-wen p { margin: 0; font-size: 19px; line-height: 1.42; }
  @media (max-width: 833px) {
    .urteil-kachel { grid-template-columns: auto minmax(0, 1fr); }
    .fuer-wen { grid-column: 1 / -1; padding: 22px 0 0; border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .urteil-kachel { grid-template-columns: 1fr; justify-items: start; }
    .urteil-kachel :global(.ring) { --g: 108px !important; }
  }

  .lesen { max-width: calc(var(--measure) + 2 * var(--gutter)); margin-top: clamp(40px, 6vw, 64px); }
  @media (min-width: 1069px) { .lesen { width: var(--measure); } }
  .motiv { margin: 0 0 36px; }
  .motiv :global(img) { border-radius: var(--radius); width: 100%; max-width: 340px; }
  .motiv figcaption { font-size: 12px; color: var(--ink-2); margin-top: 10px; }

  .prose { font-size: 19px; line-height: 1.58; letter-spacing: 0.012em; }
  .prose :global(p) { margin: 0 0 1.05em; }
  .prose :global(h2) { font-size: 28px; line-height: 1.14; font-weight: 600; margin: 1.8em 0 0.5em; letter-spacing: 0.007em; }
  .prose :global(h3) { font-size: 21px; line-height: 1.19; font-weight: 600; margin: 1.6em 0 0.4em; }
  .prose :global(blockquote) { margin: 1.6em 0; padding: 0; font-size: clamp(24px, 3vw, 32px); line-height: 1.19; font-weight: 600; letter-spacing: 0.004em; text-wrap: balance; }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; margin: 0 0 1.05em; }
  .prose :global(li) { margin-bottom: 0.35em; }
  .prose :global(li::marker) { color: var(--ink-2); }
  .prose :global(img) { border-radius: var(--radius); margin: 1.6em 0; max-height: 560px; width: auto; max-width: 100%; }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(a) { color: var(--link); }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 2.2em 0; }

  .nachtraege { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
  .nachtraege h2, .steckbrief h2 { margin: 0; font-size: 28px; line-height: 1.14; font-weight: 600; letter-spacing: 0.007em; }
  .nt-note { color: var(--ink-2); margin: 8px 0 24px; font-size: 17px; }
  .nachtraege ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .nachtraege li { position: relative; padding: 0 0 26px 26px; border-left: 2px solid var(--fill); margin-left: 5px; }
  .nachtraege li:last-child { padding-bottom: 0; }
  .nachtraege li::before { content: ''; position: absolute; left: -7px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: var(--ground); box-shadow: inset 0 0 0 3px var(--akzent); }
  .nachtraege time { font-size: 14px; font-weight: 600; }
  .nachtraege li p { margin: 4px 0 0; font-size: 17px; }

  .steckbrief { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--line); }
  dl { margin: 18px 0 0; }
  dl div { display: grid; grid-template-columns: 11rem 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  dl div:last-child { border-bottom: 0; }
  dt { font-size: 14px; font-weight: 600; color: var(--ink); }
  dd { margin: 0; font-size: 14px; color: var(--ink-2); }
  @media (max-width: 480px) { dl div { grid-template-columns: 1fr; gap: 2px; } }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 72px; }
  .pager a { display: grid; gap: 4px; padding: 22px 26px; border-radius: var(--radius); background: var(--tile); color: var(--ink); text-decoration: none; transition: transform 400ms var(--ease); }
  .pager a:hover { transform: scale(1.015); }
  .p-was { font-size: 12px; font-weight: 600; color: var(--ink-2); }
  .p-titel { font-size: 21px; line-height: 1.19; font-weight: 600; }
  .pager .next { text-align: right; grid-column: 2; }
  @media (max-width: 600px) { .pager { grid-template-columns: 1fr; } .pager .next { grid-column: auto; } }
</style>
