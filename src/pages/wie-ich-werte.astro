---
import Base from '../layouts/Base.astro';
import Ring from '../components/Ring.astro';
import { SKALA } from '../wertung';
const stufen = Object.entries(SKALA).map(([n, s]) => [Number(n), s] as const).sort((a, b) => b[0] - a[0]);
const regeln = [
  ['Eine Skala für alles.', 'Eine 7 ist bei Film, Serie und Spiel dieselbe 7.'],
  ['Die Wertung bleibt stehen.', 'Sehe ich es später anders, kommt ein datierter Nachtrag dazu.'],
  ['Fazit und „Für wen?“ gehören dazu.', 'Ein Satz, was bleibt, und für wen es sich lohnt.'],
  ['Der Stand steht dabei.', 'Abspann, komplett, abgebrochen oder läuft noch.'],
];
---
<Base title="Wie ich werte" description="Kevins Wertungsskala von 1 bis 10: ganze Zahlen, ein fester Satz pro Zahl, gleich für Spiele, Filme und Serien.">
  <header class="page-head wrap">
    <div class="kopf-schild">
      <h1>Wie ich werte</h1>
      <p>Ganze Zahlen von 1 bis 10. Für Spiele, Filme und Serien gleich.</p>
      <p class="kopf-fakt">Jede Zahl heißt immer dasselbe. Der Ring füllt sich bis zur Wertung.</p>
    </div>
  </header>

  <ol class="skala wrap" aria-label="Wertungsskala">
    {stufen.map(([n, s]) => (
      <li data-medium="neutral">
        <Ring wertung={n} medium="neutral" groesse={56} label={false} />
        <span class="s"><span class="visually-hidden">{n}: </span>{s}</span>
      </li>
    ))}
  </ol>

  <section class="regeln wrap" aria-labelledby="regeln">
    <h2 id="regeln">Vier Regeln.</h2>
    <ul>
      {regeln.map(([t, s]) => <li><h3>{t}</h3><p>{s}</p></li>)}
    </ul>
  </section>
</Base>

<style>
  /* Die Skala als Raster aus Ringen in Apple-Blau: von 10 nach 1 wird der Ring kürzer */
  .skala { list-style: none; margin: 0 auto; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .skala li { --akzent: var(--blue); display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 18px; padding: 16px 22px 16px 16px; border-radius: var(--radius); background: var(--tile); }
  .s { font-size: 17px; font-weight: 600; line-height: 1.3; text-wrap: balance; }
  @media (prefers-color-scheme: dark) { .skala li { --akzent: #2997ff; } }

  .regeln { margin-top: clamp(64px, 9vw, 110px); }
  .regeln h2 { margin: 0 0 28px; font-size: clamp(32px, 4.4vw, 48px); line-height: 1.08; font-weight: 600; letter-spacing: -0.003em; }
  .regeln ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 48px; }
  .regeln h3 { margin: 0 0 6px; font-size: 21px; line-height: 1.19; font-weight: 600; }
  .regeln p { margin: 0; font-size: 17px; color: var(--ink-2); }

  @media (max-width: 700px) {
    .skala, .regeln ul { grid-template-columns: 1fr; }
  }
</style>
