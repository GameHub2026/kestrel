---
// Navigation in der Kopfleiste oben: Textlinks, Hell/Dunkel, schwarzer Knopf rechts (Schema: redaktionelle Landingpage).
// Beim Überfahren gleitet EIN dunkles Schild waagrecht unter den Link; sein Inhalt (Kategorie + Unterpunkte)
// wechselt mit weicher Unschärfe, Breite und Höhe wachsen mit. Alt+1…4 springt in die Kategorien.
// Auf dem Handy wird daraus die Symbolleiste unten.
const path = Astro.url.pathname;
const I = {
  lesen: '<path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z"/><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"/>',
  kalender: '<rect x="3" y="4.5" width="18" height="16.5" rx="2.5"/><path d="M16 2.5v4M8 2.5v4M3 10h18"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01"/>',
  rueckblick: '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7.5V12l3 2"/>',
  skala: '<path d="M12 3v18M7 21h10"/><path d="M5 7h14"/><path d="m5 7-3 7a3.5 3.5 0 0 0 6 0z"/><path d="m19 7-3 7a3.5 3.5 0 0 0 6 0z"/>',
  neu: '<path d="M12 3l2.4 5.6L20 9l-4.3 3.9L17 19l-5-3-5 3 1.3-6.1L4 9l5.6-.4z"/>',
  liste: '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
  spiel: '<rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 11v3M5.5 12.5h3M15.5 12h.01M18 13.5h.01"/>',
  film: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"/>',
  serie: '<rect x="2.5" y="5" width="19" height="13" rx="2"/><path d="M8 21h8M12 18v3"/>',
  kino: '<path d="M4 8h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="m4 8 2.5-4.5M10 8l2.5-4.5M16 8l2.5-4.5M4 8l16 0"/>',
  jahr: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  glocke: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
  merk: '<path d="M6 3h12a1 1 0 0 1 1 1v17l-7-4-7 4V4a1 1 0 0 1 1-1z"/>',
};
const gruppen = [
  { id: 'lesen', icon: I.lesen, label: 'Lesen', href: '/', aktiv: path === '/' || path.startsWith('/texte'),
    punkte: [
      { href: '/', icon: I.neu, text: 'Neueste' },
      { href: '/texte/', icon: I.liste, text: 'Alle Texte' },
      { href: '/texte/?medium=spiel', icon: I.spiel, text: 'Spiele' },
      { href: '/texte/?medium=film', icon: I.film, text: 'Filme' },
      { href: '/texte/?medium=serie', icon: I.serie, text: 'Serien' },
    ] },
  { id: 'demnaechst', icon: I.kalender, label: 'Demnächst', href: '/demnaechst/', aktiv: path.startsWith('/demnaechst'),
    punkte: [
      { href: '/demnaechst/', icon: I.kalender, text: 'Alle Termine' },
      { href: '/demnaechst/?f=kino', icon: I.kino, text: 'Kinostarts' },
      { href: '/demnaechst/?f=serie', icon: I.serie, text: 'Serien und Folgen' },
    ] },
  { id: 'rueckblick', icon: I.rueckblick, label: 'Rückblick', href: '/archiv/', aktiv: path.startsWith('/archiv'),
    punkte: [
      { href: '/archiv/', icon: I.jahr, text: 'Nach Jahr' },
      { href: '/archiv/spiele/', icon: I.spiel, text: 'Spiele A–Z' },
      { href: '/archiv/filme/', icon: I.film, text: 'Filme A–Z' },
      { href: '/archiv/serien/', icon: I.serie, text: 'Serien A–Z' },
    ] },
  { id: 'ueber', icon: I.skala, label: 'Über', href: '/wie-ich-werte/', aktiv: path.startsWith('/wie-ich-werte') || path.startsWith('/merkliste') || path.startsWith('/serien'),
    punkte: [
      // Nur auf Kevins Geräten sichtbar (dort liegt der Merkliste-Schlüssel im Browser)
      { href: '/merkliste/', icon: I.merk, text: 'Meine Merkliste', privat: true, zaehler: 'merk' },
      { href: '/serien/', icon: I.glocke, text: 'Ich folge', privat: true, zaehler: 'serien' },
      { href: '/wie-ich-werte/', icon: I.skala, text: 'Wie ich werte' },
    ] },
];
const svg = (p: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${p}</svg>`;
---
<nav class="leiste" aria-label="Hauptnavigation" data-leiste>
  <ul class="leiste-reihe">
    {gruppen.map((g, i) => (
      <li data-id={g.id}>
        <a class="leiste-knopf" href={g.href} aria-label={g.label} aria-current={g.aktiv ? 'page' : undefined} data-taste={i + 1}>
          <Fragment set:html={svg(g.icon)} /><span class="l-text">{g.label}</span>
        </a>
      </li>
    ))}
  </ul>
  <span class="leiste-trenner" aria-hidden="true"></span>
  <button type="button" class="theme" id="theme" role="switch" aria-label="Dunkles Design" aria-checked="false" title="Hell / Dunkel">
    <span class="theme-knopf" aria-hidden="true"></span>
    <svg class="t-sonne" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
    <svg class="t-mond" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  </button>
  <a class="cta" id="cta" href="/texte/">Alle Texte</a>
  <div class="schild" aria-hidden="true">
    {gruppen.map((g, i) => (
      <div class="schild-inhalt" data-fuer={g.id}>
        <p class="schild-kopf"><span>{g.label}</span><kbd>⌥{i + 1}</kbd></p>
        {g.punkte.length > 1 && (
          <ul>
            {g.punkte.map((p) => (
              <li hidden={p.privat || undefined} data-privat={p.privat ? '' : undefined} data-zaehler={p.zaehler}><a href={p.href} tabindex="-1" aria-current={(Astro.url.pathname + Astro.url.search) === p.href ? 'page' : undefined}><Fragment set:html={svg(p.icon)} />{p.text}</a></li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</nav>

<script>
  // Private Punkte (Merkliste) nur zeigen, wenn auf diesem Gerät der Merkliste-Schlüssel gespeichert ist.
  // Dort auch die Zahl neuer News/Trailer zu beobachteten Titeln (10 Minuten zwischengespeichert).
  (async () => {
    let token = ''; try { token = localStorage.getItem('kestrel-merk-token') || ''; } catch {}
    if (!token) return;
    document.querySelectorAll<HTMLElement>('[data-privat]').forEach((li) => (li.hidden = false));
    const cta = document.getElementById('cta') as HTMLAnchorElement | null;
    if (cta) { cta.href = '/serien/'; cta.textContent = 'Ich folge'; }
    let c: { t: number; n: number; merk?: number; serien?: number } | null = null;
    try { c = JSON.parse(sessionStorage.getItem('kestrel-neu') || 'null'); if (!c || Date.now() - c.t > 600000 || c.merk == null) c = null; } catch {}
    if (!c) {
      try {
        const r = await fetch('/api/merk/neues?anzahl=1', { headers: { 'x-merk-token': token } });
        if (r.ok) { const d = await r.json(); c = { t: Date.now(), n: d.anzahl || 0, merk: d.merk || 0, serien: d.serien || 0 }; sessionStorage.setItem('kestrel-neu', JSON.stringify(c)); }
      } catch {}
    }
    const n = c?.n || 0;
    if (n > 0) {
      document.querySelectorAll<HTMLElement>('[data-zaehler]').forEach((li) => {
        const k = (c as Record<string, number>)[li.dataset.zaehler || ''] || 0;
        if (!k) return;
        const z = document.createElement('span'); z.className = 'zahl'; z.textContent = String(k); li.querySelector('a')!.append(z);
      });
      document.querySelector('[data-id="ueber"] .leiste-knopf')?.classList.add('hat-neues');
      document.querySelector('[data-id="ueber"] .leiste-knopf')?.setAttribute('aria-label', `Über, ${n} Neuigkeiten auf der Merkliste`);
      if (cta && c?.serien) { const z = document.createElement('span'); z.className = 'cta-zahl'; z.textContent = String(c.serien); cta.append(z); }
    }
  })();

  document.querySelectorAll<HTMLElement>('[data-leiste]').forEach((leiste) => {
    const schild = leiste.querySelector<HTMLElement>('.schild')!;
    const inhalte = [...schild.querySelectorAll<HTMLElement>('.schild-inhalt')];
    const punkte = [...leiste.querySelectorAll<HTMLElement>('.leiste-reihe > li')];
    let aktuell = -1; let zu = 0;

    function zeige(i: number) {
      clearTimeout(zu);
      const li = punkte[i]; const inhalt = inhalte[i];
      const vorher = aktuell; aktuell = i;
      inhalte.forEach((x, k) => {
        x.classList.toggle('an', k === i);
        x.classList.toggle('oben', k !== i && k < i);
        x.querySelectorAll('a').forEach((a) => a.tabIndex = k === i ? 0 : -1);
      });
      // Schild auf Höhe des Symbols, Größe des neuen Inhalts
      const mitte = li.offsetTop + li.offsetHeight / 2;
      schild.style.setProperty('--y', `${mitte - 17}px`);
      schild.style.setProperty('--x', `${li.offsetLeft - 6}px`);
      schild.style.width = `${inhalt.offsetWidth}px`;
      schild.style.height = `${inhalt.offsetHeight}px`;
      if (vorher < 0) { schild.classList.add('ohne-gleiten'); requestAnimationFrame(() => schild.classList.remove('ohne-gleiten')); }
      schild.classList.add('sichtbar');
      schild.setAttribute('aria-hidden', 'false');
    }
    function verstecke(sofort = false) {
      clearTimeout(zu);
      zu = window.setTimeout(() => { schild.classList.remove('sichtbar'); schild.setAttribute('aria-hidden', 'true'); aktuell = -1; }, sofort ? 0 : 260);
    }
    punkte.forEach((li, i) => {
      li.addEventListener('mouseenter', () => zeige(i));
      li.querySelector('a')!.addEventListener('focus', () => zeige(i));
      // Touch: erster Tipp zeigt das Schild, zweiter folgt dem Link
      li.querySelector('a')!.addEventListener('click', (e) => {
        if (matchMedia('(hover: none)').matches && aktuell !== i) { e.preventDefault(); zeige(i); }
      });
    });
    leiste.addEventListener('mouseleave', () => verstecke());
    leiste.querySelector('.theme')?.addEventListener('mouseenter', () => verstecke(true));
    schild.addEventListener('mouseenter', () => clearTimeout(zu));
    leiste.addEventListener('focusout', (e) => { if (!leiste.contains(e.relatedTarget as Node)) verstecke(true); });
    document.addEventListener('click', (e) => { if (!leiste.contains(e.target as Node)) verstecke(true); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return verstecke(true);
      if (!e.altKey || e.metaKey || e.ctrlKey) return;
      const n = Number(e.code.replace('Digit', ''));
      const a = leiste.querySelector<HTMLAnchorElement>(`[data-taste="${n}"]`);
      if (a) { e.preventDefault(); location.href = a.href; }
    });
  });
</script>

<style>
  /* Kopfleiste: Textlinks in einer Reihe */
  .leiste { position: relative; display: flex; align-items: center; gap: 2px; }
  .leiste-reihe { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  .leiste-reihe li { position: relative; display: grid; align-items: center; }
  .leiste-knopf {
    display: flex; align-items: center; gap: 8px; height: 34px; padding: 0 12px; border-radius: 6px; color: var(--ink-2);
    text-decoration: none; font-size: 0.86rem; font-weight: 450; letter-spacing: -0.005em;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .leiste-knopf :global(svg) { display: none; width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .leiste-knopf:hover, .leiste-knopf:focus-visible { color: var(--ink); background: color-mix(in srgb, var(--ink) 6%, transparent); outline: none; }
  .leiste-knopf[aria-current='page'] { color: var(--ink); }
  .leiste-knopf[aria-current='page']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: -13px; height: 1px; background: var(--ink); }
  .leiste-knopf.hat-neues { position: relative; }
  .leiste-knopf.hat-neues::before { content: ''; position: absolute; top: 6px; right: 4px; width: 6px; height: 6px; border-radius: 50%; background: var(--film); }
  .schild :global(.zahl) { margin-left: auto; min-width: 20px; padding: 1px 6px; border-radius: 999px; background: var(--film); color: #fff; font-family: var(--mono); font-size: 0.7rem; text-align: center; }

  /* Hell/Dunkel: kleine waagrechte Pille, der helle Knopf gleitet zur aktiven Seite */
  .leiste-trenner { display: block; width: 1px; height: 20px; margin: 0 10px; background: var(--line); }
  .theme {
    position: relative; display: grid; grid-template-columns: 26px 26px; align-items: center; justify-items: center; width: 60px; height: 32px; padding: 0 4px;
    border: 0; border-radius: 999px; background: color-mix(in srgb, var(--ink) 7%, transparent); cursor: pointer;
  }
  .theme svg { position: relative; z-index: 1; display: block; width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; color: var(--ink-2); transition: color 300ms, transform 500ms cubic-bezier(0.16, 1, 0.3, 1); }
  .theme-knopf {
    position: absolute; left: 4px; top: 4px; width: 24px; height: 24px; border-radius: 50%; background: var(--paper);
    box-shadow: 0 0 0 1px var(--line), 0 2px 6px rgb(0 0 0 / 0.12); transition: transform 450ms cubic-bezier(0.34, 1.4, 0.5, 1);
  }
  .theme[aria-checked='false'] .t-sonne, .theme[aria-checked='true'] .t-mond { color: var(--ink); }
  .theme[aria-checked='true'] .theme-knopf { transform: translateX(28px); }
  .theme:hover .t-sonne { transform: rotate(45deg); }
  .theme:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  /* Schwarzer Knopf rechts */
  .cta {
    margin-left: 12px; display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 14px; border-radius: 5px;
    background: var(--ink); color: var(--ground); text-decoration: none; font-size: 0.84rem; font-weight: 500; white-space: nowrap;
    transition: opacity 200ms ease;
  }
  .cta:hover { opacity: 0.85; }
  .cta :global(.cta-zahl) { min-width: 18px; padding: 0 5px; border-radius: 999px; background: var(--film); color: #fff; font-family: var(--mono); font-size: 0.68rem; line-height: 18px; text-align: center; }

  /* Das gleitende Schild unter den Links */
  .schild {
    --x: 0px;
    position: absolute; left: 0; top: calc(100% + 12px); transform: translateX(var(--x)) translateY(-4px) scale(0.97); transform-origin: left top;
    background: #16181b; color: #eef0f2; border-radius: 12px; overflow: hidden; opacity: 0; pointer-events: none;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25), 0 14px 32px -10px rgb(0 0 0 / 0.55), inset 0 0 0 1px rgb(255 255 255 / 0.06);
    transition: transform 420ms cubic-bezier(0.32, 1.25, 0.5, 1), width 380ms cubic-bezier(0.16, 1, 0.3, 1),
      height 380ms cubic-bezier(0.16, 1, 0.3, 1), opacity 200ms ease;
  }
  .schild.sichtbar { opacity: 1; pointer-events: auto; transform: translateX(var(--x)) translateY(0) scale(1); }
  .schild.ohne-gleiten { transition: opacity 200ms ease, transform 220ms ease; }
  .schild::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px; } /* Brücke zum Link */
  .schild-inhalt {
    position: absolute; left: 0; top: 0; width: max-content; min-width: 172px; padding: 8px 6px 6px; opacity: 0; filter: blur(6px); transform: translateY(8px);
    transition: opacity 260ms ease, filter 320ms ease, transform 380ms cubic-bezier(0.16, 1, 0.3, 1); pointer-events: none;
  }
  .schild-inhalt.oben { transform: translateY(-8px); }
  .schild-inhalt.an { opacity: 1; filter: blur(0); transform: none; pointer-events: auto; }
  .schild-kopf { margin: 0; padding: 4px 8px 6px; display: flex; align-items: center; gap: 10px; justify-content: space-between; font-family: var(--text); font-weight: 600; font-size: 0.86rem; line-height: 1.2; white-space: nowrap; }
  .schild-kopf kbd { font-family: var(--mono); font-size: 0.7rem; color: #8b929a; }
  .schild-inhalt:not(:has(ul)) { padding-bottom: 4px; }
  .schild ul { list-style: none; margin: 2px 0 0; padding: 4px 0 0; border-top: 1px solid rgb(255 255 255 / 0.08); display: grid; gap: 1px; }
  .schild a {
    display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 8px; color: #c4c9ce; text-decoration: none;
    font-family: var(--text); font-size: 0.9rem; white-space: nowrap; transition: background-color 150ms, color 150ms;
  }
  .schild a :global(svg) { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; }
  .schild a:hover, .schild a:focus-visible { background: #24272b; color: #fff; outline: none; }
  .schild a[aria-current='page'] { color: #fff; background: #24272b; }

  /* Schmale Bildschirme: Symbolleiste unten, Schild erscheint darüber */
  @media (max-width: 900px) {
    .leiste { position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); z-index: 40; background: color-mix(in srgb, var(--paper) 92%, transparent); backdrop-filter: blur(10px); border-radius: 16px; padding: 5px; box-shadow: var(--shadow), 0 10px 30px -12px rgb(0 0 0 / 0.3); }
    .leiste-knopf { width: 38px; height: 38px; padding: 0; justify-content: center; border-radius: 10px; }
    .leiste-knopf :global(svg) { display: block; }
    .leiste-knopf .l-text { display: none; }
    .leiste-knopf[aria-current='page'] { background: color-mix(in srgb, var(--ink) 10%, transparent); }
    .leiste-knopf[aria-current='page']::after { left: 50%; right: auto; bottom: -5px; width: 16px; height: 2px; margin-left: -8px; background: var(--film); }
    .leiste-trenner { height: 22px; margin: 0 6px; }
    .cta { display: none; }
    .schild { left: 50%; top: auto; bottom: 56px; transform: translateX(-50%) scale(0.96); transform-origin: center bottom; }
    .schild.sichtbar { transform: translateX(-50%) scale(1); }
    .schild::before { top: auto; bottom: -14px; }
  }
  @media (prefers-reduced-motion: reduce) { .schild, .schild-inhalt { transition: opacity 150ms ease; } }
</style>
