---
import { MEDIUM, TEXTFORM, SKALA } from '../wertung';
import { nummer, url, type Text } from '../lib';

interface Props { text: Text }
const { text: t } = Astro.props;
---
<li data-medium={t.data.medium}>
  <a href={url(t)} class="stub-row">
    <span class="s-nr mono">{nummer(t.nr)}</span>
    <span class="s-title">{t.data.titel}</span>
    <span class="s-kind mono">{MEDIUM[t.data.medium]} · {TEXTFORM[t.data.textform]}</span>
    <span class="s-say">{SKALA[t.data.wertung]}</span>
    <span class="s-score"><span class="display">{t.data.wertung}</span><span class="visually-hidden"> von 10</span></span>
  </a>
</li>

<style>
  li { list-style: none; border-bottom: 1px solid var(--line); }
  .stub-row {
    display: grid; grid-template-columns: 4.5rem 1fr auto minmax(8rem, 12rem) 3rem 1rem; align-items: center; gap: 16px;
    color: var(--ink); text-decoration: none; padding: 12px 4px; transition: background-color 200ms ease;
  }
  .stub-row::after { content: '→'; color: var(--ink-2); transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1); }
  .stub-row:hover { background: color-mix(in srgb, var(--ink) 3.5%, transparent); }
  .stub-row:hover::after { transform: translateX(4px); color: var(--ink); }
  .s-nr { font-size: 0.72rem; color: var(--ink-2); display: flex; align-items: center; gap: 10px; }
  .s-nr::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--akzent); flex: none; }
  .s-title { font-weight: 500; font-size: 1.02rem; line-height: 1.25; letter-spacing: -0.01em; min-width: 0; }
  .s-kind { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-2); }
  .s-say { font-size: 0.78rem; line-height: 1.3; color: var(--ink-2); text-align: right; }
  .s-score { text-align: right; }
  .s-score .display { font-size: 1.5rem; font-weight: 300; line-height: 1; letter-spacing: -0.03em; }

  @media (max-width: 720px) {
    .stub-row { grid-template-columns: 1fr 2.4rem; row-gap: 3px; }
    .stub-row::after, .s-say { display: none; }
    .s-nr { grid-column: 1; grid-row: 1; }
    .s-title { grid-column: 1; grid-row: 2; }
    .s-kind { grid-column: 1; grid-row: 3; }
    .s-score { grid-column: 2; grid-row: 1 / 4; }
  }
</style>
