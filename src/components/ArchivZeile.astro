---
import { MEDIUM, TEXTFORM, SKALA } from '../wertung';
import { nummer, url, type Text } from '../lib';

interface Props { text: Text }
const { text: t } = Astro.props;
---
<li data-medium={t.data.medium}>
  <a href={url(t)} class="stub-row">
    <span class="s-nr mono">{nummer(t.nr)}</span>
    <span class="s-title">{t.data.titel}</span>
    <span class="s-kind mono">{MEDIUM[t.data.medium]} · {TEXTFORM[t.data.textform]}</span>
    <span class="s-say">{SKALA[t.data.wertung]}</span>
    <span class="s-score"><span class="display">{t.data.wertung}</span><span class="visually-hidden"> von 10</span></span>
  </a>
</li>

<style>
  li { list-style: none; }
  .stub-row {
    display: grid; grid-template-columns: 5.2rem 1fr auto minmax(8rem, 12rem) 3.2rem; align-items: center; gap: 14px;
    background: var(--card); color: var(--card-ink); text-decoration: none; border-radius: 4px;
    padding: 8px 12px 8px 0; box-shadow: var(--shadow);
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .stub-row:hover { transform: translateX(4px); box-shadow: var(--shadow-lift); }
  .s-nr { font-size: 0.72rem; font-weight: 700; padding: 0 10px; border-right: 2px dashed color-mix(in srgb, var(--card-ink) 55%, transparent); align-self: stretch; display: grid; place-items: center; }
  .s-title { font-family: var(--display); font-weight: 800; text-transform: uppercase; font-size: 1.3rem; line-height: 1; min-width: 0; }
  .s-kind { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600; }
  .s-say { font-size: 0.8rem; line-height: 1.2; font-weight: 600; text-align: right; }
  .s-score { text-align: right; }
  .s-score .display { font-size: 2rem; line-height: 0.9; }

  @media (max-width: 720px) {
    .stub-row { grid-template-columns: 4.4rem 1fr 2.6rem; row-gap: 3px; }
    .s-kind { grid-column: 2; grid-row: 2; }
    .s-say { grid-column: 2; grid-row: 3; text-align: left; }
    .s-score { grid-column: 3; grid-row: 1 / 4; }
    .s-nr { grid-row: 1 / 4; }
  }
</style>
