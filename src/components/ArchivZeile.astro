---
import Ring from './Ring.astro';
import { MEDIUM, TEXTFORM, SKALA } from '../wertung';
import { url, type Text } from '../lib';

interface Props { text: Text }
const { text: t } = Astro.props;
---
<li data-medium={t.data.medium}>
  <a href={url(t)} class="zeile">
    <Ring wertung={t.data.wertung} medium={t.data.medium} groesse={44} label={false} />
    <span class="z-text">
      <span class="z-titel">{t.data.titel}</span>
      <span class="z-art">{MEDIUM[t.data.medium]} · {TEXTFORM[t.data.textform]}</span>
    </span>
    <span class="z-satz"><span class="visually-hidden">Wertung {t.data.wertung} von 10: </span>{SKALA[t.data.wertung]}</span>
  </a>
</li>

<style>
  li { list-style: none; }
  .zeile {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(8rem, 15rem); align-items: center; gap: 16px;
    padding: 12px 44px 12px 14px; border-radius: 14px; background: var(--tile); color: var(--ink); text-decoration: none;
    transition: transform 400ms var(--ease), box-shadow 400ms var(--ease);
  }
  .zeile::after { content: ''; position: absolute; right: 20px; top: 50%; width: 7px; height: 7px; margin-top: -4px; border: solid var(--ink-3); border-width: 1.6px 1.6px 0 0; transform: rotate(45deg); }
  .zeile:hover { transform: scale(1.008); box-shadow: var(--shadow-lift); text-decoration: none; }
  .z-text { display: grid; gap: 1px; min-width: 0; }
  .z-titel { font-size: 17px; font-weight: 600; line-height: 1.24; }
  .z-art { font-size: 12px; color: var(--ink-2); }
  .z-satz { font-size: 14px; line-height: 1.3; color: var(--ink-2); text-align: right; }
  @media (max-width: 720px) {
    .zeile { grid-template-columns: auto minmax(0, 1fr); }
    .z-satz { grid-column: 2; text-align: left; margin-top: -10px; font-size: 12px; }
  }
</style>
