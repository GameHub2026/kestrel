---
import { SKALA, MEDIUM, TEXTFORM, STAND } from '../wertung';
import { datum, nummer, url, type Text } from '../lib';

interface Props {
  text: Text;
  size?: 'hero' | 'row';
  link?: boolean;
  tear?: boolean; // Abriss reißt beim Laden einmal ab (Einzeltext)
  headingLevel?: 'h1' | 'h2' | 'h3';
}
const { text, size = 'row', link = true, tear = false, headingLevel = 'h2' } = Astro.props;
const d = text.data;
const H = headingLevel;
const holes = d.stand === 'abspann' ? 1 : d.stand === '100%' ? 2 : 0;
const letzterNachtrag = d.nachtraege?.at(-1);
---
<article
  class:list={['ticket', `ticket--${size}`, { 'ticket--tear': tear, 'ticket--link': link }]}
  data-medium={d.medium}
  data-stand={d.stand}
>
  <p class="kopf mono">
    <span class="punkt" aria-hidden="true"></span>
    <span>{MEDIUM[d.medium]}</span>
    <span>{TEXTFORM[d.textform]}</span>
    {d.plattform && <span>{d.plattform}</span>}
    <span><span class="visually-hidden">Stand: </span>{STAND[d.stand]}</span>
    {size === 'hero' && <span class="nr">{nummer(text.nr)} · {datum(d.datum)}</span>}
  </p>
  <div class="main">
    <H class="title">
      {link ? <a href={url(text)}>{d.titel}</a> : d.titel}
    </H>
    <p class="fazit">{d.fazit}</p>
    {size === 'hero' && letzterNachtrag && (
      <p class="nachtrag mono">Nachtrag vom {datum(letzterNachtrag.datum)}</p>
    )}
  </div>
  <div class="score" role="img" aria-label={`Wertung ${d.wertung} von 10: ${SKALA[d.wertung]}`}>
    <span class="score-num" aria-hidden="true">{d.wertung}<span class="score-of">/10</span></span>
    <span class="score-say" aria-hidden="true">{SKALA[d.wertung]}</span>
  </div>
  {link && <span class="pfeil" aria-hidden="true">→</span>}
</article>

<style>
  /* Zeile: wie eine Tabellenzeile im Satzspiegel, Medium als kleiner Farbpunkt */
  .ticket {
    position: relative; display: grid; align-items: center; color: var(--ink);
    grid-template-columns: 11rem minmax(0, 1fr) 11rem 1.5rem; gap: 6px 28px;
    padding: 18px 4px; border-bottom: 1px solid var(--line);
    transition: background-color 200ms ease;
  }
  .kopf { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; margin: 0; font-size: 0.7rem; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.05em; }
  .kopf > span:not(.punkt):not(:nth-child(2))::before { content: '·'; margin-right: 8px; opacity: 0.6; }
  .punkt { width: 7px; height: 7px; border-radius: 50%; background: var(--akzent); flex: none; margin-right: 2px; }
  .ticket--row .kopf > span:nth-child(n+4) { display: none; }
  .ticket--row .kopf { flex-direction: column; align-items: flex-start; gap: 2px; }
  .ticket--row .kopf > span::before { content: none !important; }
  .ticket--row .kopf { display: grid; grid-template-columns: 7px auto; column-gap: 10px; }
  .ticket--row .punkt { grid-row: 1 / 3; align-self: center; }
  .main { min-width: 0; }
  .title { font-family: var(--display); font-weight: 500; font-size: 1.2rem; line-height: 1.2; margin: 0; letter-spacing: -0.015em; text-wrap: balance; }
  .title a { text-decoration: none; }
  .title a::after { content: ''; position: absolute; inset: 0; }
  .title a:focus-visible { outline: none; }
  .ticket--link:has(.title a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .fazit { margin: 4px 0 0; color: var(--ink-2); font-size: 0.9rem; line-height: 1.45; max-width: 64ch; }
  .score { display: grid; justify-items: end; text-align: right; gap: 2px; }
  .score-num { font-size: 1.9rem; font-weight: 300; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .score-of { font-size: 0.75rem; color: var(--ink-2); font-weight: 400; margin-left: 2px; letter-spacing: 0; }
  .score-say { font-size: 0.72rem; line-height: 1.3; color: var(--ink-2); }
  .pfeil { color: var(--ink-2); transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), color 200ms; justify-self: end; }
  .ticket--link:hover { background: color-mix(in srgb, var(--ink) 3.5%, transparent); }
  .ticket--link:hover .pfeil { transform: translateX(4px); color: var(--ink); }

  /* Groß: gerahmtes Feld, links Text, rechts die Ziffer wie eine Kennzahl */
  .ticket--hero {
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 16rem); grid-template-rows: auto 1fr;
    align-items: start; gap: 18px 48px; padding: clamp(22px, 3vw, 40px);
    background: var(--paper); border: 1px solid var(--line); border-radius: 4px;
  }
  .ticket--hero .kopf { grid-column: 1 / -1; }
  .ticket--hero .nr { margin-left: auto; }
  .ticket--hero .nr::before { content: none !important; }
  .ticket--hero .title { font-weight: 400; font-size: clamp(1.9rem, 3.6vw, 3rem); line-height: 1.06; letter-spacing: -0.03em; }
  .ticket--hero .fazit { font-size: clamp(1rem, 1.3vw, 1.12rem); margin-top: 14px; }
  .ticket--hero .score { align-self: stretch; justify-items: start; text-align: left; align-content: end; padding-left: 32px; border-left: 1px dashed var(--rule); }
  .ticket--hero .score-num { font-size: clamp(4rem, 7vw, 5.5rem); font-weight: 300; letter-spacing: -0.05em; }
  .ticket--hero .score-of { font-size: 1rem; }
  .ticket--hero .score-say { font-size: 0.9rem; color: var(--ink); }
  .ticket--hero .pfeil { position: absolute; right: clamp(22px, 3vw, 40px); bottom: clamp(18px, 2.5vw, 30px); font-size: 1.2rem; }
  .ticket--hero.ticket--link:hover { background: var(--paper); border-color: var(--rule); }
  .nachtrag { margin: 16px 0 0; display: inline-block; font-size: 0.7rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--stamp); border: 1px solid currentColor; border-radius: 3px; padding: 3px 7px; }

  @media (max-width: 720px) {
    .ticket { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 16px; padding: 16px 2px; }
    .ticket--row .kopf { grid-column: 1 / -1; display: flex; flex-direction: row; gap: 8px; }
    .ticket--row .kopf > span:nth-child(3)::before { content: '·' !important; margin-right: 8px; }
    .main { grid-column: 1; }
    .score { grid-column: 2; grid-row: 2; }
    .score-say { display: none; }
    .pfeil { display: none; }
    .ticket--hero { grid-template-columns: 1fr; padding: 20px; }
    .ticket--hero .score { grid-column: 1; grid-row: auto; border-left: 0; padding-left: 0; padding-top: 16px; border-top: 1px dashed var(--rule); }
    .ticket--hero .score-say { display: block; }
    .ticket--hero .nr { display: none; }
  }

  /* Einzeltext: das Feld blendet beim Öffnen einmal weich ein */
  .ticket--tear { animation: auf 700ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes auf { from { opacity: 0; transform: translateY(10px); } }
</style>
