---
// Textkarte als Apple-Kachel. row: Ring links, Titel und Fazit daneben (Listen). hero: große, zentrierte Kachel (Startseite).
import Ring from './Ring.astro';
import { SKALA, MEDIUM, TEXTFORM, STAND } from '../wertung';
import { datumLang, url, type Text } from '../lib';

interface Props {
  text: Text;
  size?: 'hero' | 'row';
  link?: boolean;
  headingLevel?: 'h1' | 'h2' | 'h3';
}
const { text, size = 'row', link = true, headingLevel = 'h2' } = Astro.props;
const d = text.data;
const H = headingLevel;
const letzterNachtrag = d.nachtraege?.at(-1);
---
<article class:list={['karte', `karte--${size}`, { 'karte--link': link }]} data-medium={d.medium}>
  <Ring wertung={d.wertung} medium={d.medium} groesse={size === 'hero' ? 148 : 64} />
  <div class="karte-text">
    <p class="eyebrow">
      <span class="punkt" aria-hidden="true"></span>
      <span>{MEDIUM[d.medium]}</span><span aria-hidden="true">·</span><span>{TEXTFORM[d.textform]}</span>
      {d.plattform && <><span aria-hidden="true">·</span><span>{d.plattform}</span></>}
    </p>
    <H class="titel">{link ? <a href={url(text)}>{d.titel}</a> : d.titel}</H>
    <p class="fazit">{d.fazit}</p>
    <p class="fuss mono">
      <span>{SKALA[d.wertung]}</span>
      <span><span class="visually-hidden">Stand: </span>{STAND[d.stand]}</span>
      <time datetime={d.datum.toISOString().slice(0, 10)}>{datumLang(d.datum)}</time>
      {letzterNachtrag && <span>Nachtrag vom {datumLang(letzterNachtrag.datum)}</span>}
    </p>
    {size === 'hero' && link && <span class="mehr" aria-hidden="true">Weiterlesen</span>}
  </div>
</article>

<style>
  .karte {
    position: relative; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 22px; align-items: center;
    padding: 24px 28px; border-radius: var(--radius); background: var(--tile); color: var(--ink);
    transition: transform 400ms var(--ease), box-shadow 400ms var(--ease);
  }
  .karte--link { padding-right: 52px; }
  .karte--link::after {
    content: ''; position: absolute; right: 26px; top: 50%; width: 8px; height: 8px; margin-top: -4px;
    border: solid var(--ink-3); border-width: 1.7px 1.7px 0 0; transform: rotate(45deg);
  }
  .karte--link:hover { transform: scale(1.012); box-shadow: var(--shadow-lift); }
  .karte-text { min-width: 0; }
  .eyebrow { margin: 0 0 4px; display: flex; flex-wrap: wrap; align-items: center; gap: 0 6px; font-size: 12px; font-weight: 600; color: var(--ink-2); letter-spacing: -0.01em; }
  .punkt { width: 7px; height: 7px; border-radius: 50%; background: var(--akzent); margin-right: 1px; }
  .titel { margin: 0; font-size: 21px; line-height: 1.19; font-weight: 600; letter-spacing: 0.011em; text-wrap: balance; }
  .titel a { color: inherit; text-decoration: none; }
  .titel a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; } /* ganze Kachel klickbar */
  .titel a:focus-visible { outline: none; }
  .karte--link:has(.titel a:focus-visible) { outline: 2px solid var(--focus); outline-offset: 3px; }
  .fazit { margin: 6px 0 0; font-size: 17px; line-height: 1.47; color: var(--ink); max-width: 62ch; }
  .fuss { margin: 8px 0 0; display: flex; flex-wrap: wrap; gap: 2px 14px; font-size: 12px; color: var(--ink-2); }

  /* Groß: Startseite. Zentriert wie eine Produktkachel, Ring oben. */
  .karte--hero { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 26px; padding: clamp(44px, 6vw, 72px) clamp(24px, 6vw, 80px) clamp(40px, 5vw, 60px); border-radius: var(--radius-lg); }
  .karte--hero.karte--link { padding-right: clamp(24px, 6vw, 80px); }
  .karte--hero.karte--link::after { display: none; }
  .karte--hero.karte--link:hover { transform: scale(1.006); }
  .karte--hero .eyebrow { justify-content: center; font-size: 14px; margin-bottom: 8px; }
  .karte--hero .titel { font-size: clamp(32px, 5vw, 56px); line-height: 1.07; letter-spacing: -0.005em; }
  .karte--hero .fazit { margin: 14px auto 0; font-size: clamp(19px, 2.2vw, 24px); line-height: 1.33; color: var(--ink-2); font-weight: 400; max-width: 34ch; text-wrap: balance; }
  .karte--hero .fuss { justify-content: center; margin-top: 18px; font-size: 14px; }
  .karte--hero .mehr { margin-top: 18px; font-size: 19px; }

  @media (max-width: 600px) {
    .karte { grid-template-columns: 1fr; gap: 14px; padding: 22px 22px 24px; }
    .karte--link { padding-right: 44px; }
    .karte--link::after { right: 20px; top: 38px; }
    .karte:not(.karte--hero) :global(.ring) { --g: 52px !important; }
  }
</style>
