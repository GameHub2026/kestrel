---
// Wertung als Ring wie die Aktivitätsringe der Apple Watch: der Ring füllt sich bis zur Zahl (7 von 10 = 70 %).
// Farbe = Medium. Die Zahl steht in der Mitte; Screenreader hören „Wertung 7 von 10: Gut, …“.
import { SKALA } from '../wertung';
interface Props { wertung: number; medium: string; groesse?: number; zeichnen?: boolean; label?: boolean }
const { wertung, medium, groesse = 64, zeichnen = false, label = true } = Astro.props;
const r = 42;
const u = 2 * Math.PI * r;
const strich = groesse >= 120 ? 13 : groesse >= 64 ? 12 : 11;
---
<span
  class:list={['ring', { 'ring--zeichnen': zeichnen }]}
  data-medium={medium}
  style={`--g:${groesse}px; --u:${u.toFixed(2)}; --voll:${(u * (1 - wertung / 10)).toFixed(2)}`}
  role={label ? 'img' : undefined}
  aria-label={label ? `Wertung ${wertung} von 10: ${SKALA[wertung]}` : undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <svg viewBox="0 0 100 100" aria-hidden="true">
    <circle class="spur" cx="50" cy="50" r={r} stroke-width={strich} />
    <circle class="wert" cx="50" cy="50" r={r} stroke-width={strich} />
  </svg>
  <span class="zahl" aria-hidden="true">{wertung}</span>
</span>

<style>
  .ring { position: relative; display: inline-grid; place-items: center; width: var(--g); height: var(--g); flex: none; }
  svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); overflow: visible; }
  circle { fill: none; stroke: var(--akzent); stroke-linecap: round; }
  .spur { opacity: 0.2; }
  .wert { stroke-dasharray: var(--u); stroke-dashoffset: var(--voll); }
  .zahl {
    font-family: var(--display); font-weight: 600; font-size: calc(var(--g) * 0.36); line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--ink);
  }
  /* Der eine Moment: auf der Textseite zieht sich der Ring beim Öffnen bis zur Wertung */
  .ring--zeichnen .wert { animation: ring-zieh 1400ms cubic-bezier(0.22, 1, 0.36, 1) 250ms both; }
  @keyframes ring-zieh { from { stroke-dashoffset: var(--u); } }
</style>
