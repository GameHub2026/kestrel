---
// Animierte Themen-Szene. art="buehne": volle Fläche (Startseite, Ebenen umschließen das Fenster),
// art="kopf": rechts im Seitenkopf, läuft nach links und unten in den Hintergrund aus.
interface Props { thema: 'stadt' | 'wueste' | 'mordor' | 'maschinen' | 'ruinen' | 'western' | 'gewitter' | 'rabenwald'; art?: 'buehne' | 'kopf' }
const { thema, art = 'kopf' } = Astro.props;
---
<div class:list={['szene', `szene--${art}`]} data-szene={thema} aria-hidden="true">
  <canvas class="sz-hinten"></canvas>
  <canvas class="sz-vorne"></canvas>
  {art === 'kopf' && <div class="glas">{[0, 1, 2, 3].map(() => <i />)}</div>}
</div>
{art === 'kopf' && <div class="schleier" aria-hidden="true"></div>}

<script>
  import { starteSzenen } from '../scripts/szene/index';
  // Kopf-Szenen: beim Scrollen bleibt der Hintergrund zurück, der Vordergrund wandert mit (Tiefe)
  document.querySelectorAll<HTMLElement>('.szene--kopf').forEach((el) => {
    const verbinde = (s: any) => { s.scrollVersatz = (tiefe: number) => Math.min(scrollY, 700) * (1 - tiefe) * 0.4; };
    if ((el as any).szene) verbinde((el as any).szene); else el.addEventListener('szene-bereit', (e) => verbinde((e as CustomEvent).detail));
  });
  starteSzenen();
</script>

<style>
  .szene canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; }
  /* Bühne: die Leinwände liegen direkt in der Bühne, damit das Fenster zwischen hinten und vorne passt */
  .szene--buehne { display: contents; }
  .szene--buehne .sz-hinten { z-index: 0; }
  .szene--buehne .sz-vorne { z-index: 2; }
  .szene--buehne canvas { -webkit-mask-image: linear-gradient(to bottom, #000 82%, transparent); mask-image: linear-gradient(to bottom, #000 82%, transparent); }

  /* Kopf: Leinwand-Band über die ganze Breite, unten weicher Auslauf in den Seitengrund */
  .szene--kopf {
    position: absolute; z-index: 0; top: calc(-1 * var(--bar)); left: calc(50% - 50vw); width: 100vw; height: calc(var(--band) + 40px);
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent 100%); mask-image: linear-gradient(to bottom, #000 72%, transparent 100%);
    pointer-events: none;
  }
  /* Der Lese-Schleier wird nicht mehr gebraucht: der Text steht auf dem Titelschild */
  .schleier { display: none; }
  /* Senkrechte Glasstreifen über dem Motiv */
  .glas { position: absolute; inset: 10% 6% 18% 56%; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 70%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 70%, transparent); }
  .glas i { border-left: 1px solid rgb(255 255 255 / 0.09); backdrop-filter: blur(1.2px) saturate(1.12); background: linear-gradient(180deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.015)); }
  .glas i:last-child { border-right: 1px solid rgb(255 255 255 / 0.09); }
  @media (max-width: 760px) {
    .glas { display: none; }
  }
</style>
