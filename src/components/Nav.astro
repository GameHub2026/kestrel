---
// Navigation nach Kevins Video vom 28.10.2026: eine schmale Symbolleiste links (schwebendes Glas).
// Ein einziges dunkles Schild mit Name und Kürzel gleitet zum Symbol unter der Maus; der Text darin rollt
// beim Wechsel nach oben weg und der neue von unten herein, die Breite wächst mit.
// Felder: Start, Sammlung (Spiele, Filme, Serien), Demnächst, Archiv; dann Suchen, Hell/Dunkel und
// unten „Kevin“ (Wie ich werte). Merkliste und „Ich folge“ nur auf Kevins Geräten (Schlüssel im Browser).
// Kürzel ⌥1 … ⌥6 (⌘-Ziffern gehören im Browser den Tabs), „/“ öffnet die Suche.
// Unter 834 px wird die Leiste zur Tab-Leiste unten wie bei iOS, mit Beschriftung unter dem Symbol.
// Oben links steht das Wort „Kestrel“ in einem kleinen Glasschild; auf der Startseite fliegt es dort hinein.
const path = Astro.url.pathname;
const I = {
  start: '<circle cx="12" cy="12" r="8" class="spur" /><path d="M12 4a8 8 0 1 1-7.6 10.47" />',
  sammlung: '<rect x="4" y="9" width="16" height="11" rx="2.5" /><path d="M6.5 6h11M9 3h6" />',
  demnaechst: '<rect x="3.5" y="5" width="17" height="15.5" rx="3" /><path d="M8 3v4M16 3v4M3.5 10h17" /><path d="M8.5 14h.01M12 14h.01M15.5 14h.01M8.5 17.5h.01M12 17.5h.01" />',
  archiv: '<path d="M3.6 12a8.4 8.4 0 1 0 2.5-6L3.6 8.4" /><path d="M3.6 3.8v4.6h4.6" /><path d="M12 7.6V12l3 1.9" />',
  merk: '<path d="M7 3.5h10a1 1 0 0 1 1 1V21l-6-3.8L6 21V4.5a1 1 0 0 1 1-1Z" />',
  glocke: '<path d="M6 9a6 6 0 0 1 12 0c0 6.5 2.5 8 2.5 8h-17S6 15.5 6 9Z" /><path d="M10.2 20.5a2 2 0 0 0 3.6 0" />',
  suche: '<circle cx="10.5" cy="10.5" r="6.5" /><path d="m20 20-4.8-4.8" />',
};
const felder = [
  { id: 'start', href: '/', text: 'Start', icon: I.start, aktiv: path === '/' },
  { id: 'sammlung', href: '/texte/', text: 'Sammlung', icon: I.sammlung, aktiv: path.startsWith('/texte') },
  { id: 'demnaechst', href: '/demnaechst/', text: 'Demnächst', icon: I.demnaechst, aktiv: path.startsWith('/demnaechst') },
  { id: 'archiv', href: '/archiv/', text: 'Archiv', icon: I.archiv, aktiv: path.startsWith('/archiv') },
  { id: 'merkliste', href: '/merkliste/', text: 'Merkliste', icon: I.merk, aktiv: path.startsWith('/merkliste'), privat: true, zaehler: 'merk' },
  { id: 'folge', href: '/serien/', text: 'Ich folge', icon: I.glocke, aktiv: path.startsWith('/serien'), privat: true, zaehler: 'serien' },
];
const svg = (p: string) => `<svg viewBox="0 0 24 24" aria-hidden="true">${p}</svg>`;
const sonne = `<svg class="sonne" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.4" /><path d="M12 2.6v2M12 19.4v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.6 12h2M19.4 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>`;
const mond = `<svg class="mond" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.3 6.3 0 0 0 10.5 10.5Z" /></svg>`;
---
<div id="gn">
  <a class="gn-wort-schild" href="/" aria-label="Kestrel, Startseite">
    <span id="gn-wort" class:list={[{ 'gn-wort--start': path === '/' }]}>Kestrel</span>
  </a>

  <nav class="leiste" aria-label="Hauptnavigation" data-leiste>
    <ul class="leiste-gruppe">
      {felder.map((f, i) => (
        <li hidden={f.privat || undefined} data-privat={f.privat ? '' : undefined} data-zaehler={f.zaehler} data-handy={i < 4 ? '' : undefined}>
          <a class="feld" href={f.href} aria-current={f.aktiv ? 'page' : undefined} data-name={f.text} data-kuerzel={`⌥${i + 1}`} data-taste={i + 1}>
            <Fragment set:html={svg(f.icon)} />
            <span class="feld-name">{f.text}</span>
          </a>
        </li>
      ))}
    </ul>
    <span class="leiste-trenner" aria-hidden="true"></span>
    <ul class="leiste-gruppe">
      <li data-handy>
        <button type="button" class="feld" id="gn-suche-knopf" aria-expanded="false" aria-controls="gn-suche" data-name="Suchen" data-kuerzel="/">
          <Fragment set:html={svg(I.suche)} />
          <span class="feld-name">Suchen</span>
        </button>
      </li>
      <li class="nur-gross">
        <button type="button" class="feld" id="gn-thema" aria-pressed="false" data-name="Dunkles Design" data-kuerzel="">
          <Fragment set:html={sonne + mond} />
          <span class="feld-name">Hell oder dunkel</span>
        </button>
      </li>
      <li class="nur-gross">
        <a class="feld feld-kevin" href="/wie-ich-werte/" aria-current={path.startsWith('/wie-ich-werte') ? 'page' : undefined} data-name="Kevin · Wie ich werte" data-kuerzel="">
          <span class="kevin" aria-hidden="true">K</span>
          <span class="feld-name">Kevin, wie ich werte</span>
        </a>
      </li>
    </ul>
    <!-- Das gleitende Schild (nur Maus und Tastatur, rein visuell; die Namen stehen in den Feldern selbst) -->
    <div class="schild" aria-hidden="true"><span class="schild-rolle"></span></div>
  </nav>

  <!-- Suche wie Spotlight: schwebendes Glasfeld, darunter Schnellzugriffe -->
  <form class="gn-suche" id="gn-suche" action="/texte/" method="get" role="search" hidden>
    <div class="gn-suche-feld">
      <Fragment set:html={svg(I.suche)} />
      <label class="visually-hidden" for="gn-q">Sammlung durchsuchen</label>
      <input id="gn-q" name="q" type="search" placeholder="Sammlung durchsuchen" autocomplete="off" required />
      <kbd>esc</kbd>
    </div>
    <div class="gn-tipps">
      <p>In der Sammlung</p>
      <a href="/texte/?medium=spiel"><span class="punkt" data-medium="spiel"></span>Spiele</a>
      <a href="/texte/?medium=film"><span class="punkt" data-medium="film"></span>Filme</a>
      <a href="/texte/?medium=serie"><span class="punkt" data-medium="serie"></span>Serien</a>
      <p class="nur-handy">Mehr</p>
      <a class="nur-handy" href="/wie-ich-werte/">Wie ich werte</a>
      <a class="nur-handy" href="/merkliste/" data-privat hidden>Merkliste</a>
      <a class="nur-handy" href="/serien/" data-privat hidden>Ich folge</a>
      <button type="button" class="nur-handy gn-thema-zeile" id="gn-thema-handy" aria-pressed="false">Dunkles Design</button>
    </div>
  </form>
  <div class="gn-schleier" id="gn-schleier" hidden></div>
</div>

<script>
  const gn = document.getElementById('gn')!;
  const leiste = gn.querySelector<HTMLElement>('[data-leiste]')!;
  const schild = leiste.querySelector<HTMLElement>('.schild')!;
  const rolle = schild.querySelector<HTMLElement>('.schild-rolle')!;
  const felder = [...leiste.querySelectorAll<HTMLElement>('.feld')];
  const ruhig = matchMedia('(prefers-reduced-motion: reduce)');

  // ---------- Das gleitende Schild ----------
  let aktiv: HTMLElement | null = null, zu = 0;
  const textVon = (f: HTMLElement) => {
    const s = document.createElement('span'); s.className = 'schild-text';
    s.append(f.dataset.name || '');
    if (f.dataset.kuerzel) { const k = document.createElement('kbd'); k.textContent = f.dataset.kuerzel; s.append(k); }
    return s;
  };
  function zeige(f: HTMLElement) {
    if (matchMedia('(max-width: 833px)').matches) return;
    clearTimeout(zu);
    if (f === aktiv) return;
    const vorher = aktiv; aktiv = f;
    const neu = textVon(f);
    // Breite des neuen Textes messen, dann rollen: alter Text nach oben raus, neuer von unten rein
    neu.style.position = 'absolute'; neu.style.visibility = 'hidden'; rolle.append(neu);
    const breite = neu.offsetWidth; neu.style.position = ''; neu.style.visibility = ''; neu.remove();
    const runter = vorher ? felder.indexOf(f) > felder.indexOf(vorher) : true;
    const alt = rolle.querySelector<HTMLElement>('.schild-text:not(.weg)');
    if (alt && vorher && !ruhig.matches) {
      alt.classList.add('weg', runter ? 'nach-oben' : 'nach-unten');
      setTimeout(() => alt.remove(), 260);
      neu.classList.add('kommt', runter ? 'von-unten' : 'von-oben');
      rolle.append(neu);
      requestAnimationFrame(() => requestAnimationFrame(() => neu.classList.remove('kommt')));
    } else { rolle.replaceChildren(neu); }
    const r = f.getBoundingClientRect(), l = leiste.getBoundingClientRect();
    schild.style.setProperty('--y', `${r.top - l.top + r.height / 2}px`);
    schild.style.width = `${breite + 24}px`;
    if (!vorher) { schild.classList.add('ohne-gleiten'); requestAnimationFrame(() => requestAnimationFrame(() => schild.classList.remove('ohne-gleiten'))); }
    schild.classList.add('an');
  }
  function verstecke() {
    clearTimeout(zu);
    zu = window.setTimeout(() => { schild.classList.remove('an'); aktiv = null; setTimeout(() => { if (!aktiv) rolle.replaceChildren(); }, 200); }, 140);
  }
  felder.forEach((f) => {
    f.addEventListener('pointerenter', () => zeige(f));
    f.addEventListener('focus', () => { if (f.matches(':focus-visible')) zeige(f); });
    f.addEventListener('blur', verstecke);
  });
  leiste.addEventListener('pointerleave', verstecke);

  // ---------- Suche ----------
  const sucheKnopf = document.getElementById('gn-suche-knopf')!;
  const suche = document.getElementById('gn-suche') as HTMLFormElement;
  const schleier = document.getElementById('gn-schleier')!;
  const sucheZu = () => {
    gn.classList.remove('suche-offen'); schleier.classList.remove('an'); sucheKnopf.setAttribute('aria-expanded', 'false');
    setTimeout(() => { if (!gn.classList.contains('suche-offen')) { suche.hidden = true; schleier.hidden = true; } }, 260);
  };
  const sucheAuf = () => {
    suche.hidden = false; schleier.hidden = false;
    requestAnimationFrame(() => { gn.classList.add('suche-offen'); schleier.classList.add('an'); });
    sucheKnopf.setAttribute('aria-expanded', 'true');
    setTimeout(() => (document.getElementById('gn-q') as HTMLInputElement).focus(), 50);
  };
  sucheKnopf.addEventListener('click', () => (gn.classList.contains('suche-offen') ? sucheZu() : sucheAuf()));
  schleier.addEventListener('click', sucheZu);

  // ---------- Tastatur: ⌥1 … ⌥6 springt, „/“ sucht, Esc schließt ----------
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { sucheZu(); return; }
    const t = e.target; const tippt = t instanceof Element && t.closest('input, textarea, select, [contenteditable]');
    if (e.key === '/' && !tippt && !e.metaKey && !e.ctrlKey) { e.preventDefault(); sucheAuf(); return; }
    if (!e.altKey || e.metaKey || e.ctrlKey) return;
    const n = Number(e.code.replace('Digit', ''));
    const ziel = leiste.querySelector<HTMLAnchorElement>(`[data-taste="${n}"]`);
    if (ziel && !ziel.closest('li')?.hidden) { e.preventDefault(); location.href = ziel.href; }
  });

  // ---------- Hell/Dunkel: ohne Wahl gilt die Systemeinstellung ----------
  const root = document.documentElement;
  const thema = document.getElementById('gn-thema')!;
  const themaHandy = document.getElementById('gn-thema-handy')!;
  const systemDunkel = matchMedia('(prefers-color-scheme: dark)');
  const istDunkel = () => (root.dataset.theme ? root.dataset.theme === 'dark' : systemDunkel.matches);
  const zeigeThema = () => {
    const d = istDunkel();
    const name = d ? 'Helles Design' : 'Dunkles Design';
    [thema, themaHandy].forEach((b) => b.setAttribute('aria-pressed', String(d)));
    thema.dataset.name = name; thema.setAttribute('aria-label', name); themaHandy.textContent = name;
    if (aktiv === thema) { aktiv = null; zeige(thema); }
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((m) => {
      m.media = root.dataset.theme ? 'all' : m.hasAttribute('data-hell') ? '(prefers-color-scheme: light)' : '(prefers-color-scheme: dark)';
      if (root.dataset.theme) m.content = d ? '#161617' : '#fafafc';
    });
  };
  const wechsle = () => {
    const neu = istDunkel() ? 'light' : 'dark';
    root.classList.add('theme-wechsel');
    root.dataset.theme = neu;
    try { localStorage.setItem('kestrel-theme', neu); } catch {}
    zeigeThema();
    setTimeout(() => root.classList.remove('theme-wechsel'), 500);
  };
  thema.addEventListener('click', wechsle);
  themaHandy.addEventListener('click', wechsle);
  systemDunkel.addEventListener('change', zeigeThema);
  zeigeThema();

  // ---------- Private Felder und Zähler neuer Meldungen (10 Minuten zwischengespeichert) ----------
  (async () => {
    let token = ''; try { token = localStorage.getItem('kestrel-merk-token') || ''; } catch {}
    if (!token) return;
    gn.querySelectorAll<HTMLElement>('[data-privat]').forEach((el) => (el.hidden = false));
    let c: { t: number; n: number; merk?: number; serien?: number } | null = null;
    try { c = JSON.parse(sessionStorage.getItem('kestrel-neu') || 'null'); if (!c || Date.now() - c.t > 600000 || c.merk == null) c = null; } catch {}
    if (!c) {
      try {
        const r = await fetch('/api/merk/neues?anzahl=1', { headers: { 'x-merk-token': token } });
        if (r.ok) { const d = await r.json(); c = { t: Date.now(), n: d.anzahl || 0, merk: d.merk || 0, serien: d.serien || 0 }; sessionStorage.setItem('kestrel-neu', JSON.stringify(c)); }
      } catch {}
    }
    if (!c?.n) return;
    gn.querySelectorAll<HTMLElement>('li[data-zaehler]').forEach((li) => {
      const k = (c as Record<string, number>)[li.dataset.zaehler || ''] || 0;
      if (!k) return;
      const a = li.querySelector<HTMLElement>('.feld')!;
      a.classList.add('hat-neues'); a.dataset.name = `${a.dataset.name} · ${k} neu`;
    });
  })();
</script>

<style>
  /* ---------- Wort oben links ---------- */
  .gn-wort-schild {
    position: fixed; z-index: 51; top: 16px; left: 16px; display: inline-flex; align-items: center; height: 36px; padding: 0 14px;
    border-radius: 980px; color: var(--ink); text-decoration: none;
    background: var(--nav); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 0 0 0.5px var(--hair), 0 4px 16px rgb(0 0 0 / 0.06);
  }
  .gn-wort-schild:hover { text-decoration: none; }
  .gn-wort-schild span { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; line-height: 1; }
  /* Startseite: das Wort fliegt beim Scrollen aus dem Seitenkopf hierher (siehe index.astro); bis dahin bleibt das Schild leer */
  .gn-wort--start { opacity: 0; }

  /* ---------- Leiste links ---------- */
  .leiste {
    position: fixed; z-index: 50; left: 16px; top: 50%; transform: translateY(-50%);
    display: grid; justify-items: center; gap: 0; padding: 8px; border-radius: 22px;
    background: var(--nav); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
    box-shadow: 0 0 0 0.5px var(--hair), 0 8px 28px rgb(0 0 0 / 0.08);
  }
  .leiste-gruppe { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .leiste-trenner { display: block; width: 20px; height: 1px; margin: 8px 0; background: var(--line); }
  .feld {
    position: relative; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border: 0; border-radius: 12px;
    background: transparent; color: var(--ink); opacity: 0.72; cursor: pointer; text-decoration: none;
    transition: background-color 180ms var(--ease), opacity 180ms var(--ease);
  }
  .feld:hover, .feld:focus-visible { opacity: 1; background: color-mix(in srgb, var(--ink) 8%, transparent); text-decoration: none; outline: none; }
  .feld:focus-visible { box-shadow: 0 0 0 2px var(--focus); }
  .feld[aria-current='page'] { opacity: 1; background: color-mix(in srgb, var(--ink) 11%, transparent); }
  .feld :global(svg) { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .feld :global(.spur) { opacity: 0.3; }
  .feld-name { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .feld.hat-neues::after { content: ''; position: absolute; top: 7px; right: 7px; width: 8px; height: 8px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 0 2px var(--ground); }
  .kevin {
    display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
    background: linear-gradient(140deg, #5ac8fa, #0071e3 60%, #5e5ce6); color: #fff; font-size: 13px; font-weight: 600; letter-spacing: 0;
  }
  .feld-kevin { opacity: 1; }
  /* Hell/Dunkel: Sonne im hellen, Mond im dunklen Design */
  #gn-thema :global(.mond) { position: absolute; opacity: 0; transform: rotate(-60deg) scale(0.6); transition: opacity 300ms var(--ease), transform 450ms var(--ease); }
  #gn-thema :global(.sonne) { transition: opacity 300ms var(--ease), transform 450ms var(--ease); }
  #gn-thema[aria-pressed='true'] :global(.sonne) { opacity: 0; transform: rotate(60deg) scale(0.6); }
  #gn-thema[aria-pressed='true'] :global(.mond) { opacity: 1; transform: none; }

  /* ---------- Das gleitende Schild ---------- */
  .schild {
    --y: 0px;
    position: absolute; left: calc(100% + 10px); top: 0; height: 30px; width: 60px; border-radius: 980px; overflow: hidden;
    background: #1d1d1f; color: #f5f5f7; box-shadow: 0 4px 14px rgb(0 0 0 / 0.22), inset 0 0 0 0.5px rgb(255 255 255 / 0.08);
    transform: translateY(calc(var(--y) - 15px)) scale(0.94); transform-origin: left center; opacity: 0; pointer-events: none;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), width 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 160ms var(--ease);
  }
  .schild.an { opacity: 1; transform: translateY(calc(var(--y) - 15px)) scale(1); }
  .schild.ohne-gleiten { transition: opacity 160ms var(--ease), transform 200ms var(--ease); }
  .schild-rolle { position: relative; display: block; height: 100%; }
  .schild :global(.schild-text) {
    position: absolute; left: 12px; top: 0; height: 30px; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    font-size: 13px; font-weight: 600; letter-spacing: -0.01em;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1), opacity 200ms var(--ease), filter 220ms var(--ease);
  }
  .schild :global(kbd) { font: inherit; font-weight: 500; color: #a1a1a6; }
  .schild :global(.schild-text.kommt.von-unten) { transform: translateY(100%); opacity: 0; filter: blur(3px); }
  .schild :global(.schild-text.kommt.von-oben) { transform: translateY(-100%); opacity: 0; filter: blur(3px); }
  .schild :global(.schild-text.weg.nach-oben) { transform: translateY(-100%); opacity: 0; filter: blur(3px); }
  .schild :global(.schild-text.weg.nach-unten) { transform: translateY(100%); opacity: 0; filter: blur(3px); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .schild { background: #f5f5f7; color: #1d1d1f; } :global(:root:not([data-theme='light'])) .schild :global(kbd) { color: #6e6e73; } }
  :global(:root[data-theme='dark']) .schild { background: #f5f5f7; color: #1d1d1f; }
  :global(:root[data-theme='dark']) .schild :global(kbd) { color: #6e6e73; }

  /* Seiten rücken bei mittleren Breiten nach rechts, damit die Leiste nichts verdeckt */
  @media (min-width: 834px) and (max-width: 1160px) { :global(main), :global(.fuss-innen) { padding-left: 64px; } }

  /* ---------- Suche wie Spotlight ---------- */
  .gn-suche {
    position: fixed; z-index: 60; left: 50%; top: 14vh; width: min(640px, calc(100vw - 32px)); transform: translateX(-50%) translateY(-8px) scale(0.98);
    padding: 10px; border-radius: 26px; opacity: 0;
    background: var(--nav); -webkit-backdrop-filter: saturate(180%) blur(30px); backdrop-filter: saturate(180%) blur(30px);
    box-shadow: 0 0 0 0.5px var(--hair), 0 24px 60px rgb(0 0 0 / 0.22);
    transition: opacity 220ms var(--ease), transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  #gn.suche-offen .gn-suche { opacity: 1; transform: translateX(-50%); }
  .gn-suche-feld { display: flex; align-items: center; gap: 12px; padding: 6px 10px 6px 12px; }
  .gn-suche-feld :global(svg) { width: 22px; height: 22px; flex: none; fill: none; stroke: var(--ink-2); stroke-width: 1.8; stroke-linecap: round; }
  .gn-suche input { flex: 1; min-width: 0; border: 0; background: none; color: var(--ink); padding: 8px 0; font: 400 22px/1.2 var(--sans); letter-spacing: -0.01em; }
  .gn-suche input::placeholder { color: var(--ink-3); }
  .gn-suche input:focus { outline: none; }
  .gn-suche kbd { font: 500 12px var(--sans); color: var(--ink-3); padding: 3px 7px; border-radius: 6px; background: var(--fill); }
  .gn-tipps { display: grid; gap: 2px; padding: 8px 4px 4px; margin-top: 4px; border-top: 1px solid var(--hair); }
  .gn-tipps p { margin: 8px 10px 4px; font-size: 12px; font-weight: 600; color: var(--ink-2); }
  .gn-tipps a, .gn-tipps button {
    display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 10px; border: 0; background: none; text-align: left;
    color: var(--ink); font: 400 15px var(--sans); text-decoration: none; cursor: pointer;
  }
  .gn-tipps a:hover, .gn-tipps button:hover, .gn-tipps a:focus-visible { background: color-mix(in srgb, var(--ink) 7%, transparent); text-decoration: none; }
  .gn-tipps .punkt { width: 8px; height: 8px; border-radius: 50%; background: var(--akzent); }
  .gn-tipps [hidden] { display: none; }
  .nur-handy { display: none !important; }
  .gn-schleier { position: fixed; inset: 0; z-index: 55; background: var(--schleier); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); opacity: 0; transition: opacity 260ms var(--ease); }
  .gn-schleier.an { opacity: 1; }

