---
// Unschärfe-Verlauf, immer am unteren Bildschirmrand: Inhalt, der unten aus dem Bild läuft, verschwimmt stufenweise
// (wie Apples „Scroll Edge Effect“). Sechs Ebenen mit wachsender Unschärfe, jede nur in ihrem Streifen sichtbar.
// Über dem Footer übernimmt der Schleier dessen Farbe (--kante-ton, gesetzt in Fuss.astro).
---
<div class="kante" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>

<style>
  .kante {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 45; pointer-events: none;
    height: var(--kante);
  }
  .kante i { position: absolute; inset: 0; }
  .kante i:nth-child(1) { -webkit-backdrop-filter: blur(0.5px); backdrop-filter: blur(0.5px); --m: linear-gradient(to bottom, transparent 0%, #000 12.5%, #000 25%, transparent 37.5%); }
  .kante i:nth-child(2) { -webkit-backdrop-filter: blur(1px); backdrop-filter: blur(1px); --m: linear-gradient(to bottom, transparent 12.5%, #000 25%, #000 37.5%, transparent 50%); }
  .kante i:nth-child(3) { -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); --m: linear-gradient(to bottom, transparent 25%, #000 37.5%, #000 50%, transparent 62.5%); }
  .kante i:nth-child(4) { -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); --m: linear-gradient(to bottom, transparent 37.5%, #000 50%, #000 62.5%, transparent 75%); }
  .kante i:nth-child(5) { -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); --m: linear-gradient(to bottom, transparent 50%, #000 62.5%, #000 75%, transparent 87.5%); }
  .kante i:nth-child(6) { -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px); --m: linear-gradient(to bottom, transparent 62.5%, #000 75%, #000 100%); }
  .kante i { -webkit-mask-image: var(--m); mask-image: var(--m); }
  /* leichter Schleier in der Seitenfarbe, damit der Rand weich ausläuft */
  .kante::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--kante-ton, var(--ground)) 55%, transparent)); transition: background 400ms var(--ease); }

  @media (prefers-reduced-transparency: reduce) {
    .kante i { display: none; }
    .kante::after { background: linear-gradient(to bottom, transparent, var(--kante-ton, var(--ground))); }
  }
</style>
