---
// Umschalter im Archiv: Rückblick nach Jahr oder je Medium von A bis Z.
// Der Wechsel lädt nicht die ganze Seite neu: nur der Inhalt unter den Reitern wird getauscht,
// Seitenkopf und Szene bleiben stehen (vorher ruckelte jeder Wechsel, weil alles neu aufgebaut wurde).
import { ic } from '../icons';
const tabs = [
  { href: '/archiv/', label: 'Nach Jahr', icon: 'kalender' },
  { href: '/archiv/spiele/', label: 'Spiele A–Z', medium: 'spiel', icon: 'spiel' },
  { href: '/archiv/filme/', label: 'Filme A–Z', medium: 'film', icon: 'film' },
  { href: '/archiv/serien/', label: 'Serien A–Z', medium: 'serie', icon: 'serie' },
];
const path = Astro.url.pathname;
---
<nav class="tabs wrap" aria-label="Archiv-Ansicht" data-archiv-tabs>
  {tabs.map((t) => (
    <a href={t.href} data-medium={t.medium} aria-current={path === t.href ? 'page' : undefined}><Fragment set:html={ic(t.icon)} /><span>{t.label}</span></a>
  ))}
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-archiv-tabs]');
  if (nav) {
    const cache = new Map<string, Promise<Document>>();
    const lade = (url: string) => {
      if (!cache.has(url)) cache.set(url, fetch(url).then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.text(); }).then((t) => new DOMParser().parseFromString(t, 'text/html')));
      return cache.get(url)!;
    };
    const pfad = (a: HTMLAnchorElement) => new URL(a.href).pathname;

    async function wechsle(url: string, neu: boolean) {
      let doc: Document;
      try { doc = await lade(url); } catch { location.href = url; return; }
      // Stile der Zielseite nachladen, die hier noch fehlen (jede Archivseite hat eigene)
      const da = new Set([...document.head.querySelectorAll('link[rel="stylesheet"]')].map((l) => (l as HTMLLinkElement).href));
      const warten: Promise<unknown>[] = [];
      doc.head.querySelectorAll('link[rel="stylesheet"]').forEach((l) => {
        const href = new URL(l.getAttribute('href')!, url).href;
        if (da.has(href)) return;
        const n = document.createElement('link'); n.rel = 'stylesheet'; n.href = href;
        warten.push(new Promise((ok) => { n.onload = ok; n.onerror = ok; }));
        document.head.append(n);
      });
      const stilDa = new Set([...document.head.querySelectorAll('style')].map((s) => s.textContent));
      doc.head.querySelectorAll('style').forEach((s) => { if (!stilDa.has(s.textContent)) document.head.append(s.cloneNode(true)); });
      await Promise.all(warten);

      // Inhalt nach den Reitern tauschen, Untertitel und Titel übernehmen
      const altNav = document.querySelector('[data-archiv-tabs]')!;
      const neuNav = doc.querySelector('[data-archiv-tabs]');
      if (!neuNav) { location.href = url; return; }
      while (altNav.nextSibling) altNav.nextSibling.remove();
      let x = neuNav.nextSibling;
      const teile: Node[] = [];
      while (x) { teile.push(document.importNode(x, true)); x = x.nextSibling; }
      altNav.after(...teile);
      const unter = doc.querySelector('.page-head > p'); const hier = document.querySelector('.page-head > p');
      if (unter && hier) hier.textContent = unter.textContent;
      document.title = doc.title;
      const ziel = new URL(url, location.href).pathname;
      nav!.querySelectorAll('a').forEach((a) => { if (pfad(a) === ziel) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); });
      if (neu) history.pushState({ archiv: true }, '', url);
    }

    nav.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
      a.addEventListener('pointerenter', () => lade(a.href).catch(() => {}));
      a.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        if (a.getAttribute('aria-current') === 'page') return;
        wechsle(a.href, true);
      });
    });
    history.replaceState({ archiv: true }, '');
    addEventListener('popstate', (e) => { if (e.state?.archiv) wechsle(location.href, false); });
  }
</script>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(28px, 5vw, 48px); }
  a {
    display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 2px 18px 0 14px;
    font-family: var(--display); font-weight: 800; letter-spacing: 0.01em; text-transform: uppercase; font-size: 1.05rem;
    text-decoration: none; border-radius: 999px; background: transparent; color: var(--ink);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 20%, transparent);
    transition: box-shadow 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  a :global(.ic) { margin-top: -2px; }
  a:hover { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 45%, transparent); }
  a[aria-current='page'] { background: var(--ink); color: var(--ground); box-shadow: none; }
</style>
