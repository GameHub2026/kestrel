---
// Umschalter im Archiv: Rückblick nach Jahr oder je Medium von A bis Z.
const tabs = [
  { href: '/archiv/', label: 'Nach Jahr' },
  { href: '/archiv/spiele/', label: 'Spiele A–Z', medium: 'spiel' },
  { href: '/archiv/filme/', label: 'Filme A–Z', medium: 'film' },
  { href: '/archiv/serien/', label: 'Serien A–Z', medium: 'serie' },
];
const path = Astro.url.pathname;
---
<nav class="tabs wrap" aria-label="Archiv-Ansicht">
  {tabs.map((t) => (
    <a href={t.href} data-medium={t.medium} aria-current={path === t.href ? 'page' : undefined}>{t.label}</a>
  ))}
</nav>

<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(28px, 5vw, 48px); }
  a {
    font-family: var(--display); font-weight: 500; letter-spacing: -0.015em; font-size: 1.05rem;
    text-decoration: none; padding: 8px 14px 7px; border-radius: 4px; background: var(--paper); color: var(--ink); box-shadow: var(--shadow);
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  a:hover { transform: translateY(-2px); }
  a[aria-current='page'] { background: var(--ink); color: var(--ground); }
  a[data-medium][aria-current='page'] { background: var(--ink); color: var(--ground); }
</style>
