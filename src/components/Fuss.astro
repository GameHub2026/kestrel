---
// Footer wie auf apple.com: graue Fläche, kleine Schrift, oben ein Hinweis, darunter Linkspalten, unten Copyright und Land.
const jahr = new Date().getFullYear();
const spalten = [
  { titel: 'Lesen', links: [['/', 'Neueste'], ['/texte/', 'Alle Texte'], ['/texte/?textform=test', 'Tests'], ['/texte/?textform=kurzkritik', 'Kurzkritiken'], ['/texte/?textform=ersteindruck', 'Ersteindrücke']] },
  { titel: 'Medien', links: [['/texte/?medium=spiel', 'Spiele'], ['/texte/?medium=film', 'Filme'], ['/texte/?medium=serie', 'Serien']] },
  { titel: 'Termine', links: [['/demnaechst/', 'Demnächst'], ['/demnaechst/?f=kino', 'Kinostarts'], ['/demnaechst/?f=serie', 'Serienstarts']] },
  { titel: 'Rückblick', links: [['/archiv/', 'Nach Jahr'], ['/archiv/spiele/', 'Spiele von A bis Z'], ['/archiv/filme/', 'Filme von A bis Z'], ['/archiv/serien/', 'Serien von A bis Z']] },
  { titel: 'Über Kestrel', links: [['/wie-ich-werte/', 'Wie ich werte']] },
];
---
<footer class="fuss">
  <div class="wrap">
    <p class="fuss-hinweis">Alle Wertungen stehen auf einer Skala von 1 bis 10, für Spiele, Filme und Serien gleich. Alte Wertungen werden nie geändert; sehe ich etwas später anders, kommt ein datierter Nachtrag dazu. Termine unter „Demnächst“ stammen von TMDB und gelten für Deutschland.</p>
    <nav class="fuss-spalten" aria-label="Seitenübersicht">
      {spalten.map((s) => (
        <div class="fuss-spalte">
          <h2>{s.titel}</h2>
          <ul>{s.links.map(([href, text]) => <li><a href={href}>{text}</a></li>)}</ul>
        </div>
      ))}
    </nav>
    <div class="fuss-unten">
      <p>Copyright © {jahr} Kestrel. Geschrieben von Kevin.</p>
      <p class="fuss-links"><a href="/wie-ich-werte/">Wie ich werte</a><a href="/archiv/">Archiv</a><a href="/sitemap-index.xml">Sitemap</a></p>
      <p class="fuss-land">Deutschland</p>
    </div>
  </div>
</footer>

<style>
  .fuss { margin-top: clamp(64px, 10vw, 120px); background: var(--ground-2); color: var(--ink-2); font-size: 12px; line-height: 1.33; letter-spacing: -0.01em; padding: 18px 0 calc(var(--kante) + 4px); }
  .fuss a { color: var(--ink-2); }
  .fuss a:hover { color: var(--ink); text-decoration: underline; }
  .fuss-hinweis { margin: 0; padding: 17px 0 11px; border-bottom: 1px solid var(--line); }
  .fuss-spalten { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; padding: 20px 0 14px; }
  .fuss-spalte h2 { margin: 0 0 9px; font-family: var(--sans); font-size: 12px; font-weight: 600; color: var(--ink); letter-spacing: -0.01em; }
  .fuss-spalte ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; }
  .fuss-unten { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 30px; padding-top: 16px; border-top: 1px solid var(--line); }
  .fuss-unten p { margin: 0; }
  .fuss-links { display: flex; flex-wrap: wrap; }
  .fuss-links a { padding: 0 10px; border-left: 1px solid var(--line); line-height: 1; }
  .fuss-links a:first-child { padding-left: 0; border-left: 0; }
  .fuss-land { margin-left: auto !important; }

  @media (max-width: 833px) {
    .fuss-spalten { grid-template-columns: 1fr 1fr; gap: 24px 20px; }
    .fuss-spalte ul { gap: 0; }
    .fuss-spalte li a { display: block; padding: 6px 0; font-size: 14px; }
    .fuss-unten { flex-direction: column; }
    .fuss-land { margin-left: 0 !important; order: -1; }
  }
</style>
