---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Meldungen from '../components/Meldungen.astro';
import Fuss from '../components/Fuss.astro';
import Kante from '../components/Kante.astro';

interface Props {
  title?: string;
  description?: string;
  privat?: boolean; // nicht in Suchmaschinen
}
const { title, privat = false, description = 'Kevin schreibt über Spiele, Filme und Serien. Eine Skala von 1 bis 10 für alles, alte Wertungen bleiben stehen, Nachträge kommen dazu.' } = Astro.props;
const fullTitle = title ? `${title} · Kestrel` : 'Kestrel · Spiele, Filme und Serien von Kevin';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#fafafc" media="(prefers-color-scheme: light)" data-hell />
    <meta name="theme-color" content="#161617" media="(prefers-color-scheme: dark)" data-dunkel />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {privat && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      // Hell/Dunkel vor dem ersten Zeichnen: gespeicherte Wahl, sonst Systemeinstellung.
      try { var t = localStorage.getItem('kestrel-theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#inhalt">Zum Inhalt springen</a>
    <Nav />
    <Meldungen />
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />
    <Kante />
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--blue); color: #fff; padding: 10px 16px; border-radius: 980px; z-index: 100; }
  .skip:focus { left: 12px; }
</style>
